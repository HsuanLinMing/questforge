    "scene_10_ending_clear": {
      "title": "結尾（推理正確）",
      "narration": [
        {
          "role": "narrator",
          "text": "原來蝴蝶小美剛剛在玩水球的時候，不小心讓一顆水球漏氣了。"
        },
        {
          "role": "narrator",
          "text": "大人（老師）：因為水球破了，所以才會變得扁扁軟軟的。"
        },
        {
          "role": "narrator",
          "text": "大人（老師）：蝴蝶小美，謝謝你誠實告訴大家。"
        },
        {
          "role": "narrator",
          "text": "蝴蝶小美：對不起，我不是故意的，下次會更小心。"
        },
