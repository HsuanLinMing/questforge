    "scene_06_hypothesis_1": {
      "title": "小偵探的猜想",
      "narration": [
        {
          "role": "lele",
          "text": "我在想，也許有人剛剛在公車上玩貼紙遊戲，結果不小心掉了一些。"
        },
        {
          "role": "feifei",
