    "scene_01_warmup_3": {
      "title": "小偵探的好奇心啟動",
      "narration": [
        {
          "role": "feifei",
          "text": "你看那個紅色帽子的小豆，他剛剛一直看著後面座位，好像發現什麼。"
        },
        {
          "role": "lele",
          "text": "真的耶，他的眼睛亮亮的，比司機大叔的後照鏡還亮。"
        },
        {
          "role": "narrator",
          "text": "大家的注意力開始慢慢轉向車廂後方，一切看起來還是平靜。"
        },
        {
          "role": "feifei",
          "text": "我們用放大鏡模式看看，說不定有什麼小秘密藏在這裡喔！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
