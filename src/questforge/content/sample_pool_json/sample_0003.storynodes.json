    "scene_02_incident": {
      "title": "公車上的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "突然，公車停了一下，司機大叔說話了。"
        },
        {
          "role": "narrator",
          "text": "司機大叔：各位同學，請稍微注意一下，車上好像有東西被移動了。"
        },
        {
          "role": "lele",
          "text": "欸？什麼東西被移動了？"
        },
        {
          "role": "feifei",
          "text": "我們來看看，發現了什麼奇怪的事情。"
        },
        {
          "role": "narrator",
          "text": "紅帽小豆和書包小丸子也開始注意四周，大家的眼睛像小燈泡一樣亮著。"
        },
        {
          "role": "narrator",
          "text": "公車裡的小秘密，等著大家一起發現呢。"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
