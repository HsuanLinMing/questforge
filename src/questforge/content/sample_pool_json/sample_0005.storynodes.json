  "nodes": {
    "scene_01_start": {
      "title": "熱鬧的夜市開場",
      "narration": [
        {
          "role": "narrator",
          "text": "今天晚上，霏霏和樂樂跟著爸爸媽媽來到了熱鬧的夜市。"
        },
        {
          "role": "narrator",
          "text": "夜市裡燈光閃閃，攤位擠滿了各種美食和小玩意兒。"
        },
        {
          "role": "narrator",
          "text": "他們一家人在一家賣糖葫蘆的小攤前停下來，攤主是甜甜圈小阿呆。"
        },
        {
          "role": "narrator",
          "text": "甜甜圈小阿呆：來嘗嘗我的招牌糖葫蘆，甜甜又脆脆的！"
        },
        {
          "role": "feifei",
          "text": "這糖葫蘆看起來好漂亮喔，亮晶晶的。"
        },
        {
          "role": "lele",
          "text": "我想吃三串！不行嗎？"
        },
        {
          "role": "narrator",
          "text": "甜甜圈小阿呆：當然可以，多吃多開心！"
        },
        {
          "role": "narrator",
          "text": "旁邊還有膠帶小黏的攤位，他在賣五顏六色的彩色膠帶。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：這膠帶黏黏的，還可以貼在手上玩呢！"
        },
        {
          "role": "feifei",
          "text": "哇，你的膠帶好多顏色，我都不知道挑哪一個了。"
        },
        {
          "role": "lele",
          "text": "我想要藍色的，像天空一樣的藍！"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：藍色是最受歡迎的哦！"
        },
        {
          "role": "narrator",
          "text": "走著走著，樂樂突然看到一個攤位前有個人擺著一大堆氣球。"
        },
        {
          "role": "narrator",
          "text": "氣球小泡泡：快來看我的氣球動物，會跳舞哦！"
        },
        {
          "role": "feifei",
          "text": "氣球動物還會跳舞？真的假的？"
        },
        {
          "role": "lele",
          "text": "我想要一隻會跳舞的狗狗氣球！"
        },
        {
          "role": "narrator",
          "text": "氣球小泡泡：來，給你！看，牠跳得多開心！"
        },
        {
          "role": "narrator",
          "text": "霏霏和樂樂邊玩邊逛，夜市裡的聲音好熱鬧，有叫賣聲、笑聲還有小吃的香味。"
        },
        {
          "role": "feifei",
          "text": "欸，你有沒有發現那攤子的燈泡閃得比別人快？"
        },
        {
          "role": "lele",
          "text": "真的耶，是故意的嗎？還是壞掉了？"
        },
        {
          "role": "feifei",
          "text": "不知道耶，我們去看看好了！"
        },
        {
          "role": "lele",
          "text": "好啊，我的小偵探眼睛要亮起來了！"
        },
        {
          "role": "feifei",
          "text": "我們要用放大鏡模式，偷偷看看有什麼怪怪的地方。"
        },
        {
          "role": "lele",
          "text": "我的眼睛閃閃發亮，準備出動！"
        },
        {
          "role": "feifei",
          "text": "嗯嗯，這樣才有趣嘛，夜市裡的秘密等著我們去發現！"
        }
      ],
      "choices": [
        {
          "text": "繼續",
          "next": "scene_01_warmup_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_2": {
      "title": "夜市裡的熱鬧與小插曲",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂繼續在夜市裡走著，看到好多小攤子和人群。"
        },
        {
          "role": "lele",
          "text": "那邊有個賣烤香腸的攤子，好香喔！"
        },
        {
          "role": "feifei",
          "text": "我看那個烤爐上冒著煙，香腸看起來好大好飽滿。"
        },
        {
          "role": "narrator",
          "text": "烤香腸攤的老闆是餅乾小脆，他笑嘻嘻地招呼大家。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：來來來，烤得剛剛好的香腸，吃了會開心！"
        },
        {
          "role": "lele",
          "text": "我想要一根最胖的！"
        },
        {
          "role": "feifei",
          "text": "你又開始挑戰最大了。"
        },
        {
          "role": "narrator",
          "text": "突然，一陣風吹過，氣球小泡泡的氣球輕輕晃動，發出沙沙的聲音。"
        },
        {
          "role": "narrator",
          "text": "氣球小泡泡：哎呀，風好大，我的氣球快飛走了！"
        },
        {
          "role": "lele",
          "text": "快抓住！不然氣球要飛到天上去了！"
        },
        {
          "role": "feifei",
          "text": "我差點以為氣球會變成小飛船帶我們飛起來呢。"
        },
        {
          "role": "lele",
          "text": "那我就要坐在狗狗氣球上，飛到月球去！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_3": {
      "title": "好奇心轉場，小偵探模式啟動",
      "narration": [
        {
          "role": "feifei",
          "text": "欸欸，樂樂，你剛剛看到那個攤位旁邊的桌子，好像有東西不太一樣耶。"
        },
        {
          "role": "lele",
          "text": "哪裡？我沒注意到耶。"
        },
        {
          "role": "feifei",
          "text": "就是那張桌子，好像有人把椅子挪動了，還有點黏黏的感覺。"
        },
        {
          "role": "lele",
          "text": "欸？黏黏的？會不會是糖漿掉下來了？"
        },
        {
          "role": "feifei",
          "text": "也許吧，不過我覺得怪怪的，想用放大鏡模式再去看看。"
        },
        {
          "role": "lele",
          "text": "我的眼睛閃閃發亮，準備當小偵探！"
        },
        {
          "role": "feifei",
          "text": "好，我們悄悄走過去，看看有沒有什麼特別的。"
        },
        {
          "role": "lele",
          "text": "我覺得這夜市好像藏著好多秘密喔！"
        },
        {
          "role": "feifei",
          "text": "沒錯，說不定哪裡會有什麼有趣的發現呢！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_02_incident": {
      "title": "夜市的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到那張被挪動的桌子旁邊，看見桌上放著幾個顏色鮮艷的氣球。"
        },
        {
          "role": "lele",
          "text": "欸，氣球好像少了一個耶？"
        },
        {
          "role": "feifei",
          "text": "真的欸，剛剛氣球小泡泡那邊明明好多的。"
        },
        {
          "role": "narrator",
          "text": "氣球小泡泡正在忙著幫別人吹氣球，沒注意到這邊的變化。"
        },
        {
          "role": "lele",
          "text": "我聽到有人說，剛剛好像有聽到『啪』的一聲？"
        },
        {
          "role": "feifei",
          "text": "啪？像氣球破掉的聲音嗎？"
        },
        {
          "role": "narrator",
          "text": "附近的小朋友們開始小聲討論，有些人看著地上的碎片。"
        },
        {
          "role": "lele",
          "text": "我看到地上有一點黏黏的東西，像是糖漿還是黏膠。"
        },
        {
          "role": "feifei",
          "text": "欸，那桌子好像也被挪動過，椅子擺的位置不太一樣。"
        },
        {
          "role": "lele",
          "text": "我想知道發生了什麼事，是誰弄的嗎？"
        },
        {
          "role": "feifei",
          "text": "嗯嗯，我們先不急著猜，先看看還有什麼發現。"
        },
        {
          "role": "narrator",
          "text": "夜市的燈光閃爍，熱鬧的聲音依然圍繞著他們，但霏霏和樂樂的眼睛開始變得更亮了。"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_03_check_1": {
      "title": "第一個發現",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏蹲下來仔細看桌子底下，發現地上有一片透明的貼紙背紙。"
        },
        {
          "role": "feifei",
          "text": "欸，樂樂，這個摸起來黏黏的耶，好像剛剛有人撕貼紙留下的。"
        },
        {
          "role": "lele",
          "text": "我看到貼紙背紙掉在角落，還有一點點糖果包裝紙。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏走過來，看到地上的東西。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：喔喔，這貼紙背紙我剛才有用過，可能是我不小心掉的。"
        },
        {
          "role": "feifei",
          "text": "那糖果包裝紙呢？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：這個我沒看到耶，可能是別的小朋友吃完掉的吧。"
        },
        {
          "role": "lele",
          "text": "我聽到旁邊有人說，好像有人剛剛坐過這張椅子，椅子還有點晃呢。"
        },
        {
          "role": "feifei",
          "text": "欸，椅子晃啊？會不會是有人剛剛坐著玩手機？"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
          "next": "scene_04_check_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_04_check_2": {
      "title": "換個角度看看",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到桌子的另一邊，看到桌腳有點擦痕。"
        },
        {
          "role": "lele",
          "text": "欸，桌腳有點擦傷，好像被東西拖過去的痕跡。"
        },
        {
          "role": "feifei",
          "text": "我摸了摸，桌腳有點冷冷的，像剛剛有人碰過水。"
        },
        {
          "role": "narrator",
          "text": "氣球小泡泡走過來，拍了拍桌子。"
        },
        {
          "role": "narrator",
          "text": "氣球小泡泡：我剛剛在吹氣球，可能不小心碰到桌子，讓椅子移動了。"
        },
        {
          "role": "lele",
          "text": "我看到桌子上有一個小氣球碎片，跟我的氣球顏色不太一樣。"
        },
        {
          "role": "feifei",
          "text": "那氣球碎片會不會是別人的氣球破掉掉下來的？"
        },
        {
          "role": "lele",
          "text": "還有我聽到旁邊有小孩子在笑，好像在說『氣球怪獸出現啦』。"
        },
        {
          "role": "feifei",
          "text": "氣球怪獸？哈哈，那應該是玩笑話吧。"
        }
      ],
      "choices": [
        {
          "text": "換個地方看看",
