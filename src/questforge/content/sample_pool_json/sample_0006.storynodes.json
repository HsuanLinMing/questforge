    "scene_02_incident": {
      "title": "餐廳的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "就在霏霏和樂樂準備靠近那塊亮亮的地板時，飯糰啵啵突然皺起眉頭。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：欸，我的飲料杯好像不太對勁耶。"
        },
        {
          "role": "lele",
          "text": "怎麼了？是漏水還是被喝了一口？"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我剛剛放在桌上的吸管現在不見了！"
        },
        {
          "role": "feifei",
          "text": "吸管不見了？剛剛我們還看見你拿著彩色吸管耶。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：可是我剛剛喝完果汁後，吸管就不見了。"
        },
        {
          "role": "narrator",
          "text": "店員小方走過來，小聲問了幾句，然後看了看周圍。"
        },
        {
          "role": "narrator",
          "text": "店員小方：嗯…剛剛有人經過這裡，好像不小心碰到桌子。"
        },
        {
          "role": "lele",
          "text": "桌子被碰了？是哪一桌？"
        },
        {
          "role": "narrator",
          "text": "店員小方：就是你們這邊，感覺有點晃動。"
        },
        {
          "role": "feifei",
          "text": "欸，難道有人不小心碰到吸管？"
        },
        {
          "role": "lele",
          "text": "可是誰會偷偷拿吸管啊？"
        },
        {
          "role": "narrator",
          "text": "旁邊的餅乾小脆也跑過來，手上拿著一根彩色吸管。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：這是你們的吸管嗎？我剛剛在地上看到，還以為是我的呢！"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：欸？真的耶！怎麼會掉在地上？"
        },
        {
          "role": "feifei",
          "text": "你們有沒有發現地板上有點黏黏的？"
        },
        {
          "role": "lele",
          "text": "對啊，我剛剛還以為是糖果掉下來了。"
        },
        {
          "role": "narrator",
          "text": "大家開始用眼睛和手指仔細查看那塊地板，想知道吸管是怎麼掉到那裡的。"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
