      "can_quit": null
    },
    "scene_01_warmup_2": {
      "title": "開場延伸：餐廳裡的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "樂樂突然發現桌上有一張小紙條，紙條被折成一個小船的形狀。"
        },
        {
          "role": "lele",
          "text": "欸？這是誰留下的小船？我想像它會不會自己航行。"
        },
        {
          "role": "feifei",
          "text": "你想像力真豐富，不過小船可能只是被風吹到這裡吧。"
        },
        {
          "role": "narrator",
          "text": "隔壁桌的膠帶小黏在幫忙包裝生日禮物，他的膠帶一不小心黏到自己的手指，掙扎著想掙脫。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：哎呀，我變成了活膠帶人了！誰來救救我！"
        },
        {
          "role": "feifei",
          "text": "哈哈，你看，他都快變成黏黏怪獸了。"
        },
        {
          "role": "lele",
          "text": "我想幫他，不過怕自己也被黏住。"
        },
        {
          "role": "narrator",
          "text": "店裡的音樂換成了輕快的爵士樂，讓整個餐廳氣氛變得更活潑。"
        },
        {
          "role": "feifei",
          "text": "這音樂讓我忍不住想跳舞，樂樂你敢跟我跳嗎？"
        },
        {
          "role": "lele",
          "text": "我跳舞像小企鵝，會跌倒喔。"
        },
        {
          "role": "feifei",
          "text": "沒關係，我們一起跌倒也很有趣！"
        },
        {
          "role": "narrator",
          "text": "這時候，店員小方走過來，手上端著一盤剛出爐的餅乾，香味撲鼻而來。"
        },
        {
          "role": "narrator",
          "text": "店員小方：誰想吃餅乾？剛烤好的，熱呼呼的！"
        },
        {
          "role": "lele",
          "text": "我舉手！我舉手！"
        },
        {
          "role": "feifei",
          "text": "別搶，大家都有份。"
        },
        {
          "role": "narrator",
          "text": "餐廳外面突然傳來一陣鳥叫聲，像是在提醒大家午休時間快到了。"
        },
        {
          "role": "feifei",
          "text": "欸，你聽到那聲音了嗎？好像在叫我們快點吃完。"
        },
        {
          "role": "lele",
          "text": "鳥兒們也餓了吧！"
        },
        {
          "role": "feifei",
          "text": "那我們也要加快速度，不然鳥兒會把我們的食物偷走！"
        },
        {
          "role": "lele",
          "text": "哈哈，你想像力又開始飛了。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵回來了，手裡多了一個彩色的吸管，看起來很開心。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我剛剛問了，今天有新口味的果汁喔！"
        },
        {
          "role": "feifei",
          "text": "哇，那我們也要試試看！"
        },
        {
          "role": "lele",
          "text": "我要最紅色的，因為紅色是超級英雄的顏色！"
        },
        {
          "role": "feifei",
          "text": "好，那我就選綠色，像森林一樣神秘。"
        },
        {
          "role": "narrator",
          "text": "大家都笑了，餐廳裡充滿了歡樂的氣氛。"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
