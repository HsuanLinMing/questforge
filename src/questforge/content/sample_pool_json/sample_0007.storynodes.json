    "scene_01_warmup_2": {
      "title": "開場延伸：熱鬧的露營區",
      "narration": [
        {
          "role": "narrator",
          "text": "露營區裡的帳篷排列得整整齊齊，還掛著彩色的燈泡。"
        },
        {
          "role": "narrator",
          "text": "樂樂看到遠處有個穿紅色帽子的同學，手裡拿著一個大大的橡皮小方玩具。"
        },
        {
          "role": "lele",
          "text": "欸，那個是誰？拿著橡皮小方，好像在找什麼東西。"
        },
        {
          "role": "feifei",
          "text": "那是餅乾小脆的好朋友，橡皮小方超黏人的。"
        },
        {
          "role": "narrator",
          "text": "突然，一陣風吹過，樹葉沙沙作響，還帶來一點松果的香味。"
        },
        {
          "role": "lele",
          "text": "這裡的風好涼，感覺像在森林裡玩耍。"
        },
        {
          "role": "feifei",
          "text": "我覺得我們應該多看看四周，說不定會發現新朋友或者新玩具呢！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
