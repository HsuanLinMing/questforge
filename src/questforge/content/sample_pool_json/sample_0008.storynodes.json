    "scene_01_warmup_2": {
      "title": "開場延伸：更多超市趣事",
      "narration": [
        {
          "role": "narrator",
          "text": "樂樂和霏霏走到果汁區，看到瓶子排得整整齊齊。"
        },
        {
          "role": "lele",
          "text": "欸，那瓶子怎麼有點歪了？是不是有人偷偷動過？"
        },
        {
          "role": "feifei",
          "text": "歪了？我看它像是在跟我們眨眼睛。"
        },
        {
          "role": "narrator",
          "text": "旁邊的餅乾小脆正在試吃新口味，嘴巴咬得嘎吱嘎吱響。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：這個味道有點鹹鹹的，好像海洋的味道耶！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
