    "scene_10_ending_clear": {
      "title": "結尾（阿桃的故事）",
      "narration": [
        {
          "role": "narrator",
          "text": "大人：原來是阿桃忙著貼標籤，手上的貼紙不小心掉在地上。"
        },
        {
          "role": "narrator",
          "text": "大人：因為阿桃剛收到新貨，要快點整理貨架，手忙腳亂才會這樣。"
        },
        {
          "role": "narrator",
          "text": "大人：阿桃也對大家說聲對不起，讓大家感覺有點亂。"
        },
        {
          "role": "narrator",
          "text": "大人：下次阿桃會更小心，避免貼紙掉落造成困擾。"
        },
