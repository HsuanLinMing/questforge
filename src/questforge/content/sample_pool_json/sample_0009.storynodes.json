    "scene_02_incident": {
      "title": "便利商店的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂蹲在門口，看到地上有一小片透明的貼紙背膠黏在地板上。"
        },
        {
          "role": "lele",
          "text": "欸？這個摸起來黏黏的，好像剛剛阿桃手上的東西掉下來的。"
        },
        {
          "role": "feifei",
          "text": "可是阿桃剛剛忙著整理貨架，怎麼會有貼紙掉在這裡呢？"
        },
        {
          "role": "narrator",
          "text": "這時，阿桃轉頭看了過來，手上還拿著一包新到的糖果。"
        },
        {
          "role": "narrator",
          "text": "阿桃：啊，你們看到那個黏黏的是貼紙背膠喔？我剛剛貼標籤的時候，好像掉了一點。"
        },
        {
          "role": "lele",
          "text": "那糖果看起來包裝有點皺皺的，是不是也被你貼過標籤？"
        },
        {
          "role": "narrator",
          "text": "阿桃：是啊，剛剛新貨到，要貼上價格標籤。"
        },
        {
          "role": "narrator",
          "text": "啵啵和小方也走了過來，啵啵手上多了一張黃色小貓貼紙。"
        },
        {
          "role": "narrator",
          "text": "啵啵：我剛剛看到小方偷偷拿了一張貼紙貼在書包上喔。"
        },
        {
          "role": "narrator",
          "text": "小方：沒有啦，我只是想試試看貼紙黏不黏。"
        },
        {
          "role": "feifei",
          "text": "嗯，這裡好像有點小混亂，大家都在忙著自己的事情。"
        },
        {
          "role": "lele",
          "text": "我聽到店裡的門鈴叮咚叮咚響，有人進來又有人出去，好熱鬧。"
        },
        {
          "role": "feifei",
          "text": "我覺得我們的眼睛要變得更亮，才能發現更多有趣的細節！"
        },
        {
          "role": "lele",
          "text": "對啊！我覺得這裡面藏著小秘密，只是我們還沒找到呢！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_03_check_1": {
      "title": "貨架上的小發現",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到糖果貨架前，仔細觀察每一包糖果。"
        },
        {
          "role": "lele",
          "text": "欸，我看到有一包糖果包裝皺皺的，好像被擠過。"
        },
        {
          "role": "feifei",
          "text": "皺皺的？是在哪一排？"
        },
        {
          "role": "lele",
          "text": "就在最下面那一排，靠近門口的地方。"
        },
        {
          "role": "narrator",
          "text": "旁邊一位穿著綠色帽子的阿綠也在選糖果，他手上拿著一包沒有貼標籤的糖果。"
        },
        {
          "role": "narrator",
          "text": "阿綠：這包糖果看起來新鮮嗎？我不太確定。"
        },
        {
          "role": "feifei",
          "text": "我聽到你說不確定，這種感覺很正常。"
        },
        {
          "role": "lele",
          "text": "我剛剛還聽到阿桃和阿綠說話，阿桃說剛剛貨架有點亂。"
        },
        {
          "role": "narrator",
          "text": "貨架旁邊有一張小紙條，上面寫著「請勿隨意搬動商品」。"
        },
        {
          "role": "feifei",
          "text": "這裡有很多細節，我們要用眼睛和耳朵好好記住喔！"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
