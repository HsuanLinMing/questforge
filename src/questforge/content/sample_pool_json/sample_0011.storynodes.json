    "scene_01_warmup_2": {
      "title": "開場延伸：公園的小插曲",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂繼續在公園裡走著。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏突然站起來，手上還黏著一小片葉子。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：欸？我的膠帶好像多了一點葉子耶，好黏喔！"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：哈哈哈，黏黏的膠帶變成葉子收藏器了！"
        },
        {
          "role": "lele",
          "text": "我想像膠帶小黏變成了森林守護者，專門收集掉落的葉子。"
        },
        {
          "role": "feifei",
          "text": "哈哈哈，那我就是他的助手，幫他找膠帶。"
        },
        {
          "role": "narrator",
          "text": "這時候，紅帽子小朋友跳繩跳到一半，突然停下來，皺著眉頭看著地上的一個小坑洞。"
        },
        {
          "role": "narrator",
          "text": "紅帽子小朋友：欸？這個坑洞怎麼有點濕濕的？"
        },
        {
          "role": "narrator",
          "text": "藍球小朋友：我剛剛在這附近玩水槍，可能是水流過去的痕跡吧。"
        },
        {
          "role": "lele",
          "text": "水槍大作戰？聽起來好好玩喔！"
        },
        {
          "role": "feifei",
          "text": "等一下，我覺得我們的眼睛要更亮一點，說不定這裡藏著什麼秘密呢！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
