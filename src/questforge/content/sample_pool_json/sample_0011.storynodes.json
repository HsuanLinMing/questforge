      "can_replay": null,
      "can_quit": null
    },
    "scene_04_check_2": {
      "title": "附近的秋千區",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走向秋千區，想從另一個角度找找看。"
        },
        {
          "role": "narrator",
          "text": "秋千旁有一個小包包，包包外面沾著一點泥土。"
        },
        {
          "role": "lele",
          "text": "這個包包看起來有點皺皺的，好像被踩過。"
        },
        {
          "role": "feifei",
          "text": "你看包包的拉鍊有點開著，是不是有人放東西進去又忘了拉上？"
        },
        {
          "role": "narrator",
          "text": "紅帽子小朋友走過來，指著包包說。"
        },
        {
          "role": "narrator",
          "text": "紅帽子小朋友：這是我妹妹的包包，剛剛她說放在這裡的。"
        },
        {
          "role": "lele",
          "text": "可是包包怎麼會掉在地上？"
        },
        {
          "role": "feifei",
          "text": "說不定是風吹的，或者有人不小心碰倒了？"
        },
        {
          "role": "lele",
          "text": "我剛剛看到膠帶小黏在那邊玩膠帶，會不會是他不小心碰到？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：哎呀，我的膠帶果然黏黏的，可能真的碰到了包包。"
        },
        {
          "role": "feifei",
          "text": "嗯，這樣說也有可能喔。"
        }
      ],
