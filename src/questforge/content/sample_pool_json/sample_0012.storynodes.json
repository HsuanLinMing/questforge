    "scene_02_incident": {
      "title": "博物館的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到恐龍蛋旁邊，發現展區突然安靜了下來。"
        },
        {
          "role": "narrator",
          "text": "小方館員皺著眉頭，看著恐龍蛋附近的地板。"
        },
        {
          "role": "narrator",
          "text": "小方館員：咦？這裡的恐龍蛋好像被移動過了？"
        },
        {
          "role": "feifei",
          "text": "欸，樂樂，你有沒有看到什麼不一樣的地方？"
        },
        {
          "role": "lele",
          "text": "我聽到有人輕輕地說「不好了」，聲音有點急。"
        },
        {
          "role": "narrator",
          "text": "其他小朋友也慢慢圍了過來，大家的眼睛都盯著那個蛋。"
        },
        {
          "role": "feifei",
          "text": "我們來看看周圍有沒有什麼特別的東西，好好用眼睛和耳朵觀察！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_03_check_1": {
      "title": "恐龍蛋旁的發現",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏蹲下身子，仔細看地上的痕跡。"
        },
        {
          "role": "feifei",
          "text": "欸，你看這裡有一些細細的腳印，好像小動物的腳印。"
        },
        {
          "role": "lele",
          "text": "腳印有點黏黏的，好像踩到糖漿一樣。"
        },
        {
          "role": "narrator",
          "text": "啵啵走過來，手上還拿著半包爆米花。"
        },
        {
          "role": "narrator",
          "text": "啵啵：我剛才在這附近吃爆米花，可能掉了一些。"
        },
        {
          "role": "feifei",
          "text": "那腳印可能是誰踩過這裡呢？"
        },
        {
          "role": "lele",
          "text": "我覺得應該不是恐龍，恐龍腳印應該大大的！"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
          "next": "scene_04_check_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_04_check_2": {
      "title": "展區另一角",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到恐龍展的另一角。"
        },
        {
          "role": "narrator",
          "text": "牆上掛著一幅大大的恐龍圖畫，畫框有點歪了。"
        },
        {
          "role": "feifei",
          "text": "欸，這幅畫好像被碰過，框框有點鬆掉。"
        },
        {
          "role": "lele",
          "text": "我聽到有人說「喔喔」，像是驚訝的聲音。"
        },
        {
          "role": "narrator",
          "text": "啵啵：我剛剛經過這裡，看到一隻小貓咪跑過去，牠應該沒進來吧？"
        },
        {
          "role": "feifei",
          "text": "小貓咪？牠會不會也踩到那個黏黏的東西？"
        },
        {
          "role": "lele",
          "text": "如果是小貓咪，牠一定很調皮。"
        }
      ],
      "choices": [
        {
          "text": "換個地方看看",
          "next": "scene_05_check_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
