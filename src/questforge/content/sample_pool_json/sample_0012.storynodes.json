    "scene_05_check_3": {
      "title": "奇怪的膠帶怪物？",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏蹲下來，看到地上有一小片透明膠帶。"
        },
        {
          "role": "lele",
          "text": "欸？這膠帶摸起來黏黏的，好像怪物的口水！"
        },
        {
          "role": "feifei",
          "text": "怪物口水？哈哈，那你要小心不要被膠帶怪黏住喔！"
        },
        {
          "role": "narrator",
          "text": "啵啵笑著說："
        },
        {
          "role": "narrator",
          "text": "啵啵：我覺得膠帶怪會偷偷躲起來，然後突然跳出來嚇人！"
        },
        {
          "role": "lele",
          "text": "哈哈，那我不想被嚇到，我要拿膠帶怪做我的新朋友！"
        },
        {
          "role": "feifei",
          "text": "說不定膠帶怪是恐龍展的守護神呢？"
        },
        {
          "role": "lele",
          "text": "守護神？那牠會不會也怕爆米花？"
        }
      ],
      "choices": [
        {
          "text": "我有一個猜想",
          "next": "scene_06_hypothesis_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
