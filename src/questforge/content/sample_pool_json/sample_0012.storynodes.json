    "scene_01_warmup_2": {
      "title": "博物館裡的小插曲",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走向恐龍蛋旁邊，發現地上有一點點黏黏的東西。"
        },
        {
          "role": "lele",
          "text": "欸？這個黏黏的是什麼？像糖漿還是膠水？"
        },
        {
          "role": "narrator",
          "text": "啵啵：我剛剛的爆米花袋子好像破了一點，可能掉下來了。"
        },
        {
          "role": "feifei",
          "text": "哈哈，爆米花變成恐龍的點心了嗎？"
        },
        {
          "role": "lele",
          "text": "如果恐龍真的吃爆米花，牠們會不會變成大大的爆米花恐龍？"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_3": {
      "title": "小偵探模式開啟",
      "narration": [
        {
          "role": "feifei",
          "text": "我們開啟小偵探模式，眼睛要亮亮的喔！"
        },
        {
          "role": "lele",
          "text": "我覺得這裡有好多秘密藏著，像寶藏一樣。"
        },
        {
          "role": "feifei",
          "text": "對啊，我們悄悄地用放大鏡看，別讓恐龍聽到。"
        },
        {
          "role": "lele",
          "text": "欸，我先偷偷看那個角落，可能有什麼東西沒被發現！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
