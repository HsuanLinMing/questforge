    "scene_02_incident": {
      "title": "發現了奇怪的便條紙",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂悄悄走到那張桌子前。"
        },
        {
          "role": "narrator",
          "text": "桌上放著一張折皺的便條紙，旁邊還有幾本打開的書。"
        },
        {
          "role": "lele",
          "text": "欸，這張紙上寫著什麼，好像有點模糊。"
        },
        {
          "role": "feifei",
          "text": "有人剛剛好像在這裡翻書，然後不小心把便條紙弄皺了。"
        },
        {
          "role": "narrator",
          "text": "附近的椅子上有一個藍色的帽子，似乎有人剛剛坐過。"
        },
        {
          "role": "narrator",
          "text": "還有地上有一點點黏黏的東西，像是糖果的包裝紙。"
        },
        {
          "role": "lele",
          "text": "欸，這些東西放在一起，好像有點不一樣耶。"
        },
        {
          "role": "feifei",
          "text": "嗯，我們先不要急著說什麼，先看看還有什麼其他的。"
        },
        {
          "role": "narrator",
          "text": "突然，有個小朋友走過來，手上拿著一本厚厚的故事書。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：欸，你們在看什麼呢？我剛剛在找我的膠帶，結果好像弄丟了。"
        },
        {
          "role": "lele",
          "text": "你剛剛說膠帶黏黏的，會不會跟這裡有關？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：有可能喔，我剛剛好像聽到有人翻書的聲音。"
        },
        {
          "role": "feifei",
          "text": "嗯，我們來看看附近其他地方吧，也許會發現更多。"
        },
        {
          "role": "lele",
          "text": "對，我的眼睛還亮亮的，偵探模式繼續！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_03_check_1": {
      "title": "書架旁的發現",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到靠近窗戶的書架旁。"
        },
        {
          "role": "narrator",
          "text": "書架上有一本書掉到地上，封面有點皺皺的。"
        },
        {
          "role": "lele",
          "text": "欸，這本書好像剛剛被翻過，頁面有點亂。"
        },
        {
          "role": "feifei",
          "text": "而且書角還有一點黏黏的東西，摸起來像糖漿。"
        },
        {
          "role": "narrator",
          "text": "附近的地毯上有一小塊透明的貼紙背紙，像是剛撕下來的。"
        },
        {
          "role": "lele",
          "text": "這貼紙會不會是從膠帶小黏的膠帶掉下來的？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：有可能耶，我的膠帶有時候會不小心掉東西。"
        },
        {
          "role": "feifei",
          "text": "我們再看看別的地方，說不定還有什麼。"
        },
        {
          "role": "lele",
          "text": "好，我的偵探眼睛還沒累呢！"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
          "next": "scene_04_check_2",
          "enabled": true,
