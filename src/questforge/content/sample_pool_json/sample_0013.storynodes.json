    "scene_01_warmup_3": {
      "title": "好奇心轉場（小偵探模式）",
      "narration": [
        {
          "role": "lele",
          "text": "欸，我剛剛看到桌子上有一張便條紙，好像被折來折去的。"
        },
        {
          "role": "feifei",
          "text": "真的耶，還有點皺皺的，好像有人偷偷摸過。"
        },
        {
          "role": "lele",
          "text": "我想知道那張紙上寫了什麼，感覺有點神秘。"
        },
        {
          "role": "feifei",
          "text": "我們去偷偷看看，好像有什麼小秘密藏在裡面呢！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
