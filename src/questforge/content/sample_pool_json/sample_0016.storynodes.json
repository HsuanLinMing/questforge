    "scene_10_ending_defer": {
      "title": "結尾（交給大人來處理）",
      "narration": [
        {
          "role": "narrator",
          "text": "大人：這件事讓大家都有點忙亂，沒關係，我們一起來看看發生什麼。"
        },
