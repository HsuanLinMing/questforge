    "scene_10_ending_clear": {
      "title": "結尾（故事解開）",
      "narration": [
        {
          "role": "narrator",
          "text": "大人：原來呢，是飯糰啵啵不小心把糖果掉了一地，攤位看起來亂亂的。"
        },
        {
