  "nodes": {
    "scene_01_start": {
      "title": "夜市的熱鬧開場",
      "narration": [
        {
          "role": "narrator",
          "text": "今天晚上，霏霏和樂樂跟著爸爸媽媽來到熱鬧的夜市。"
        },
        {
          "role": "narrator",
          "text": "夜市裡燈火通明，攤位排得長長的，香味四溢。"
        },
        {
          "role": "narrator",
          "text": "霏霏看到有賣糖葫蘆的小攤，旁邊還有賣臭豆腐的攤位。"
        },
        {
          "role": "lele",
          "text": "哇！我聞到炸雞的味道，好香啊！"
        },
        {
          "role": "feifei",
          "text": "欸，你看那邊的攤位擺了好多玩具，還有賣爆米花的呢。"
        },
        {
          "role": "narrator",
          "text": "爸爸牽著樂樂的手，媽媽提著裝滿小吃的袋子。"
        },
        {
          "role": "narrator",
          "text": "爸爸：你們想先去哪一攤？"
        },
        {
          "role": "lele",
          "text": "我要去玩射氣球，好像很好玩！"
        },
        {
          "role": "feifei",
          "text": "我想去看那個賣彩色氣球的阿姨，她吹的氣球形狀很特別哦。"
        },
        {
          "role": "narrator",
          "text": "走著走著，他們遇到了兩個熟悉的朋友。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：你們好啊！我剛買了超大的棉花糖，好想吃喔！"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：我在找我的橡皮擦，不知道掉哪裡了。"
        },
        {
          "role": "feifei",
          "text": "餅乾小脆，你剛剛不是一直在玩那個彈珠嗎？"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：對啊，我想可能掉在那邊的攤位附近。"
        },
        {
          "role": "lele",
          "text": "欸欸，我看到那邊有一個攤位桌子上有點亂，說不定是那裡。"
        },
        {
          "role": "feifei",
          "text": "我們去看看吧，順便逛逛夜市。"
        },
        {
          "role": "narrator",
          "text": "攤位上掛著彩燈，風一吹，燈泡發出閃閃的光。"
        },
        {
          "role": "lele",
          "text": "我聽到旁邊傳來吱吱的聲音，好像老鼠跑過。"
        },
        {
          "role": "feifei",
          "text": "不會吧，夜市裡有老鼠？你確定不是小鳥？"
        },
        {
          "role": "lele",
          "text": "咦？有道理，我沒看清楚啦。"
        },
        {
          "role": "narrator",
          "text": "他們走近攤位，看到桌上有一張皺皺的便條紙和幾個糖果包裝紙。"
        },
        {
          "role": "feifei",
          "text": "欸，這便條紙上有什麼字？好像寫著什麼名字。"
        },
        {
          "role": "lele",
          "text": "我摸到桌子邊緣有點黏黏的，好像有人剛剛撒了糖粉。"
        },
        {
          "role": "feifei",
          "text": "哈哈，糖粉當然會黏啊，你想像成怪物的口水了吧？"
        },
        {
          "role": "lele",
          "text": "欸，我只是說說嘛！說不定是怪物真的來過！"
        },
        {
          "role": "feifei",
          "text": "好啦好啦，怪物也會逛夜市嗎？我想像他拿著爆米花的樣子。"
        },
        {
          "role": "lele",
          "text": "哈哈哈，那我也想像他穿著氣球衣服！"
        },
        {
          "role": "narrator",
          "text": "他們笑著，繼續往前走，眼睛亮亮地留意著四周。"
        },
        {
          "role": "feifei",
          "text": "我們用小小偵探模式，偷偷看看有沒有什麼特別的地方。"
        },
        {
          "role": "lele",
          "text": "對！用放大鏡看，看看有沒有什麼不一樣的東西。"
        },
        {
          "role": "feifei",
          "text": "我覺得夜市裡每個攤位都像藏寶箱，裡面藏著好多故事呢！"
        },
        {
          "role": "lele",
          "text": "哇，那我們要不要先去找找看有沒有什麼特別的東西？"
        },
        {
          "role": "feifei",
          "text": "好啊，我們一起去看看吧！"
        }
      ],
      "choices": [
        {
          "text": "繼續",
          "next": "scene_01_warmup_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_2": {
      "title": "夜市的小插曲",
      "narration": [
        {
          "role": "narrator",
          "text": "他們走到一個賣風車的小攤位，風車隨風轉動，發出呼呼聲。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：欸，風車轉得好快喔！我想試試看能不能吹得更快。"
        },
        {
          "role": "lele",
          "text": "我試試用嘴巴吹，結果差點把風車吹飛了，哈哈。"
        },
        {
          "role": "feifei",
          "text": "小心點，別吹飛了別人的風車，不然要賠錢了。"
        },
        {
          "role": "narrator",
          "text": "旁邊的膠帶小黏笑著說，他剛剛用膠帶黏了一隻小鳥的羽毛在帽子上，看起來很酷。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：欸，你們看我變成小鳥帽子啦！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_3": {
      "title": "小偵探模式啟動",
      "narration": [
        {
          "role": "feifei",
          "text": "欸欸，我覺得有點奇妙耶，為什麼那個攤位的桌布有點皺皺的？"
        },
        {
          "role": "lele",
          "text": "我也有注意到，還有地上踩到軟軟的東西，好像是糖果包裝紙。"
        },
        {
          "role": "feifei",
          "text": "我們要不要用放大鏡模式，仔細看看這裡有沒有什麼不一樣的？"
        },
        {
          "role": "lele",
          "text": "好啊，我覺得眼睛要亮亮的，像小偵探一樣！"
        },
        {
          "role": "feifei",
          "text": "說不定會發現什麼秘密呢，嘻嘻。"
        },
        {
          "role": "lele",
          "text": "我覺得這裡好像藏著什麼故事，我們去看看吧！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
