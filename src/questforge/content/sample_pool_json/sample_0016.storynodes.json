    "scene_02_incident": {
      "title": "夜市的怪怪狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "他們走近那個攤位，發現桌上放著一個小盒子，盒蓋微微開著。"
        },
        {
          "role": "lele",
          "text": "欸？這個盒子怎麼會這樣？好像有人剛剛動過它。"
        },
        {
          "role": "feifei",
          "text": "我聽到旁邊有小聲的嘀咕聲，好像有人在找東西。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我剛剛放在這裡的糖果，好像位置被換過了耶。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我也看到桌上多了一張皺皺的紙條，剛剛沒有的。"
        },
        {
          "role": "feifei",
          "text": "欸欸，這裡好像有點不太一樣，我們來看看發生了什麼事吧！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
