    "scene_03_check_1": {
      "title": "第一個觀察點：售票機旁",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到售票機旁邊，地上有一張皺皺的紙片。"
        },
        {
          "role": "lele",
          "text": "欸，這張紙片摸起來黏黏的，好像剛剛被膠帶黏過。"
        },
        {
          "role": "feifei",
          "text": "我看到旁邊的售票機有一個按鈕好像被按得比其他的深一點。"
        },
        {
          "role": "narrator",
          "text": "旁邊有個穿藍色制服的阿偉，他正在和別人講話，手上拿著一個藍色水壺。"
        },
        {
          "role": "narrator",
          "text": "阿偉（站務員）：我剛剛看到有人在這裡按按鈕，不知道是不是忘了拿票卡。"
        },
        {
          "role": "lele",
          "text": "我聽到他說的話，好像有人一直在售票機附近晃來晃去。"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
          "next": "scene_04_check_2",
          "enabled": true,
          "tag": ""
        }
      ],
