    "scene_01_warmup_2": {
      "title": "開場延伸：車站裡的小插曲",
      "narration": [
        {
          "role": "narrator",
          "text": "樂樂看到一隻小狗從旁邊跑過，尾巴搖得像小刷子。"
        },
        {
          "role": "lele",
          "text": "欸，那隻小狗好可愛，它身上有個藍色的項圈耶。"
        },
        {
          "role": "feifei",
          "text": "我看到小狗旁邊有個小男孩，他拿著一個橘色的足球。"
        },
        {
          "role": "narrator",
          "text": "車站的廣播聲穿插著人群的笑聲和腳步聲，熱鬧又溫暖。"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
