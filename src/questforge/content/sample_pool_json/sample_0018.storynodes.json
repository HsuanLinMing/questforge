    "scene_02_incident": {
      "title": "突然出現的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "當霏霏和樂樂靠近那個攤位時，發現攤位上的桌布被風吹得有點歪。"
        },
        {
          "role": "narrator",
          "text": "攤位負責人餅乾小脆皺著眉頭，正在撐著桌布。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：哎呀，這風怎麼這麼調皮，桌布都快飛起來了！"
        },
        {
          "role": "lele",
          "text": "欸，我剛剛聽到旁邊有人說，剛才桌上的東西好像被移動過。"
        },
        {
          "role": "feifei",
          "text": "嗯？是嗎？我剛才沒看到，不過我們可以多留意看看。"
        },
        {
          "role": "narrator",
          "text": "旁邊的飯糰啵啵也走了過來，他手上拿著一個小盒子。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我剛剛在箱子旁邊看到一張皺皺的紙，好像是活動的規則。"
        },
        {
          "role": "feifei",
          "text": "皺皺的？那紙有沒有被弄破或是弄髒？"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：看起來有點折痕，也有點黏黏的，好像有東西沾上去了。"
        },
        {
          "role": "lele",
          "text": "欸欸，這怪怪的耶！是誰弄的呢？"
        },
        {
          "role": "feifei",
          "text": "欸欸，別急，我們先看看發生了什麼。"
        },
        {
          "role": "lele",
          "text": "好啦好啦，我只是覺得怪怪的。"
        },
        {
          "role": "feifei",
          "text": "對啊，我們的眼睛和耳朵要變得更厲害，說不定能發現什麼秘密呢！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_03_check_1": {
      "title": "第一個觀察：桌布和紙張",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏蹲下身，仔細看那張皺皺的紙。"
        },
        {
          "role": "feifei",
          "text": "紙上有些地方看起來濕濕的，是不是剛剛有人不小心碰到水？"
        },
        {
          "role": "lele",
          "text": "欸，我剛剛聽到旁邊傳來一聲「啪」的聲音，好像是貼紙被撕開的聲音。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我剛剛摸到桌布的邊角，有點黏黏的，不知道是什麼東西。"
        },
        {
          "role": "feifei",
          "text": "黏黏的？你剛剛摸在哪裡？"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：就在桌布右下角，靠近箱子的地方。"
        },
        {
          "role": "lele",
          "text": "我想像那黏黏的是怪獸的口水，哈哈哈！"
        },
        {
          "role": "feifei",
          "text": "哈哈哈，要是怪獸來了，我們可要跑得快！"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
          "next": "scene_04_check_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_04_check_2": {
      "title": "第二個觀察：箱子旁的鞋子",
      "narration": [
        {
          "role": "narrator",
          "text": "樂樂走到箱子旁邊，注意到地上有一隻鞋子。"
        },
        {
          "role": "lele",
          "text": "欸？這隻鞋子怎麼只有一隻？另一隻呢？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我剛剛幫忙搬東西，看到鞋子旁邊有點泥巴印子，好像有人剛剛走過這裡。"
        },
        {
          "role": "feifei",
          "text": "泥巴印子？是濕濕的還是乾乾的？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：是濕濕的，還有點涼涼的感覺。"
        },
        {
          "role": "lele",
          "text": "欸欸，是不是剛剛下過雨？泥巴才會濕濕的？"
        },
        {
          "role": "feifei",
          "text": "嗯，可能是這樣。不過鞋子怎麼會掉在這裡呢？"
        },
        {
          "role": "lele",
          "text": "我覺得可能是有人忘記穿上，然後跑去玩了。"
        },
        {
          "role": "feifei",
          "text": "也可能是鞋子自己跑出來玩啦（笑）"
        }
      ],
      "choices": [
        {
          "text": "換個地方看看",
          "next": "scene_05_check_3",
          "enabled": true,
