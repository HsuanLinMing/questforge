    "scene_01_warmup_3": {
      "title": "好奇心轉場（小偵探模式啟動）",
      "narration": [
        {
          "role": "feifei",
          "text": "欸，我剛剛看到那邊有個小攤位，好像有人在忙著整理東西。"
        },
        {
          "role": "lele",
          "text": "真的耶！那邊還有個大箱子，箱子旁邊放著一雙鞋子，好像有人剛脫下來。"
        },
        {
          "role": "feifei",
          "text": "我們去偷偷看看，好像有什麼有趣的事情要發生喔！"
        },
        {
          "role": "lele",
          "text": "我的眼睛亮亮的，準備好當小偵探了！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
