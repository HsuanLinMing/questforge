    "scene_01_start": {
      "title": "開場：社區活動的熱鬧早晨",
      "narration": [
        {
          "role": "narrator",
          "text": "今天早上，社區公園裡聚集了很多人。"
        },
        {
          "role": "narrator",
          "text": "大家正在準備一年一度的社區文化節。"
        },
        {
          "role": "feifei",
          "text": "樂樂，你看那邊有攤位耶，好多彩色氣球！"
        },
        {
          "role": "lele",
          "text": "哇！我想去那個賣爆米花的攤位！"
        },
        {
          "role": "narrator",
          "text": "攤位旁邊有兩位志工在忙著掛布條。"
        },
        {
          "role": "narrator",
          "text": "店員：這次的文化節一定會很熱鬧，大家都準備得很用心。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我幫忙貼這個布條，黏黏的，很有趣！"
        },
        {
          "role": "narrator",
          "text": "樂樂對膠帶小黏手上的膠帶很感興趣。"
        },
        {
          "role": "lele",
          "text": "欸，膠帶小黏，你的膠帶看起來好黏喔！"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：對啊，黏黏的感覺超療癒！"
        },
        {
          "role": "feifei",
          "text": "哈哈，樂樂你會不會想舔一舔？"
        },
        {
          "role": "lele",
          "text": "才不要，我怕黏在嘴巴上，變成膠帶怪獸！"
        },
        {
          "role": "narrator",
          "text": "旁邊的飯糰啵啵正和餅乾小脆玩跳繩。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：快看我跳得多高！"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：欸，我也要挑戰一下！"
        },
        {
          "role": "lele",
          "text": "我也來試試看！"
        },
        {
          "role": "feifei",
          "text": "小心別被繩子打到哦！"
        },
        {
          "role": "narrator",
          "text": "風輕輕吹過，帶來淡淡的烤香味，好像是烤玉米的味道。"
        },
        {
          "role": "feifei",
          "text": "你聞到了嗎？那香味讓我肚子餓了。"
        },
        {
          "role": "lele",
          "text": "我想吃烤玉米！還有棉花糖！"
        },
        {
          "role": "narrator",
          "text": "遠處傳來孩子們的笑聲和叫賣聲，氣氛熱鬧又歡樂。"
        },
        {
          "role": "feifei",
          "text": "欸，我覺得我們的眼睛要變成放大鏡，偷偷看看大家在忙什麼好不好？"
        },
        {
          "role": "lele",
          "text": "對啊！小偵探模式啟動！我眼睛亮亮的！"
        },
        {
          "role": "feifei",
          "text": "我也是！我們去看看有沒有什麼有趣的東西藏在角落裡！"
        }
      ],
      "choices": [
        {
          "text": "繼續",
          "next": "scene_01_warmup_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_2": {
      "title": "開場延伸：更多社區活動的歡笑",
      "narration": [
        {
          "role": "narrator",
          "text": "樂樂和霏霏走到了一個擺著彩色氣球的攤位前。"
        },
        {
          "role": "lele",
          "text": "這些氣球怎麼有的像星星，有的像動物？"
        },
        {
          "role": "feifei",
          "text": "看起來像是剛被風吹過，氣球在跳舞呢！"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏突然跑過來，手裡拿著一個貼紙本。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：嘿，你們要不要試試看貼紙交換？我這裡有很多可愛的動物貼紙喔！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
