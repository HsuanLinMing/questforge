  "nodes": {
    "scene_01_start": {
      "title": "開場：運動中心的熱鬧",
      "narration": [
        {
          "role": "narrator",
          "text": "今天是週末，運動中心裡熱熱鬧鬧的。"
        },
        {
          "role": "narrator",
          "text": "霏霏和樂樂跟著爸爸媽媽來這裡玩。"
        },
        {
          "role": "narrator",
          "text": "運動中心裡有籃球場、游泳池和攀岩區。"
        },
        {
          "role": "feifei",
          "text": "欸，樂樂，你看那邊有好多小朋友在打籃球耶。"
        },
        {
          "role": "lele",
          "text": "我也想玩！可是我還不會投籃。"
        },
        {
          "role": "narrator",
          "text": "爸爸：別急，先去暖暖身，等一下我們一起玩。"
        },
        {
          "role": "narrator",
          "text": "媽媽：那邊有攀岩牆，小黏和小脆也來了，他們準備比賽呢。"
        },
        {
          "role": "narrator",
          "text": "小黏是一個戴著藍色頭巾的男孩，小脆則是拿著紅色水壺的女孩。"
        },
        {
          "role": "narrator",
          "text": "小黏：霏霏，你看我今天練習了好多次攀岩！"
        },
        {
          "role": "narrator",
          "text": "小脆：我剛喝完水，準備上場了！"
        },
        {
          "role": "feifei",
          "text": "哇，你們好厲害！我跟樂樂還在學呢。"
        },
        {
          "role": "lele",
          "text": "我剛剛踩到一塊滑滑的東西，好像是水珠。"
        },
        {
          "role": "feifei",
          "text": "水珠？那你剛剛在哪裡踩到的？"
        },
        {
          "role": "lele",
          "text": "就在籃球場旁邊的地板上，好像有人剛剛灑水。"
        },
        {
          "role": "narrator",
          "text": "運動中心裡播放著輕快的音樂，空氣裡有運動飲料的甜味。"
        },
        {
          "role": "narrator",
          "text": "爸爸：記得喝水，運動要保持水分喔。"
        },
        {
          "role": "narrator",
          "text": "媽媽：還有，地上有水要小心別滑倒。"
        },
        {
          "role": "feifei",
          "text": "樂樂，我們去看看攀岩區那邊吧，聽說今天有小小比賽。"
        },
        {
          "role": "lele",
          "text": "好啊！我還想看誰爬得最快。"
        },
        {
          "role": "narrator",
          "text": "攀岩牆上掛著彩色的繩索，還有貼著星星貼紙的小旗子。"
        },
        {
          "role": "feifei",
          "text": "欸，你看那個紅色繩索的旁邊，好像有一個小東西掉下來了。"
        },
        {
          "role": "lele",
          "text": "真的假的？我去撿看看！"
        },
        {
          "role": "feifei",
          "text": "小聲點，像小偵探一樣，偷偷用眼睛看清楚！"
        },
        {
          "role": "lele",
          "text": "我開啟放大鏡模式了！我們去看看那個掉下來的小東西是什麼！"
        }
      ],
      "choices": [
        {
          "text": "繼續",
          "next": "scene_01_warmup_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_2": {
      "title": "更多運動中心的日常",
      "narration": [
        {
          "role": "narrator",
          "text": "樂樂彎下腰撿起一個亮晶晶的小貼紙。"
        },
        {
          "role": "lele",
          "text": "欸，好像是星星貼紙耶！"
        },
        {
          "role": "feifei",
          "text": "貼紙？剛剛攀岩牆上的小旗子也有星星貼紙耶。"
        },
        {
          "role": "narrator",
          "text": "小黏：那是我的！我剛剛在練習的時候，不小心掉了。"
        },
        {
          "role": "narrator",
          "text": "小脆：我剛剛看到小黏在攀岩的時候，還踩到一點點黏黏的東西。"
        },
        {
          "role": "lele",
          "text": "黏黏的？是什麼東西啊？"
        },
        {
          "role": "feifei",
          "text": "欸，我想像那東西變成小怪獸，黏黏怪獸會黏住手腳，爬山就很難了！"
        },
        {
          "role": "lele",
          "text": "哈哈，那我不要遇到黏黏怪獸，我怕被黏住，動不了！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_3": {
      "title": "好奇心轉場：小偵探模式開啟",
      "narration": [
        {
          "role": "feifei",
          "text": "我們先把這個貼紙放一邊，繼續看攀岩區其他地方好了。"
        },
        {
          "role": "lele",
          "text": "對呀，我想知道黏黏的東西到底是什麼。"
        },
        {
          "role": "feifei",
          "text": "我們像小偵探一樣，眼睛亮亮的，偷偷看清楚每個細節！"
        },
        {
          "role": "lele",
          "text": "我開啟放大鏡模式了，準備發現大秘密！"
        },
        {
          "role": "feifei",
          "text": "不過也不用太緊張啦，說不定只是大家玩得太開心，東西掉了而已。"
        },
        {
          "role": "lele",
          "text": "好啦好啦，我知道了，我們去看看其他地方！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
