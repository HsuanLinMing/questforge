      "can_quit": null
    },
    "scene_05_check_3": {
      "title": "店裡另一角的發現",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂來到便利商店的冷藏區，看到一個塑膠袋掛在冰箱門把上。"
        },
        {
          "role": "lele",
          "text": "欸？這塑膠袋看起來有點皺皺的，好像剛被人掛上去。"
        },
        {
          "role": "feifei",
          "text": "袋子裡面有什麼？"
        },
        {
          "role": "lele",
          "text": "摸起來有點黏黏的，好像是果凍。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏靠近聞了聞，說："
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：有點香香甜甜的味道，像是草莓口味的果凍。"
        },
        {
          "role": "feifei",
          "text": "會不會是有人放在這裡忘記拿走了？"
        },
        {
          "role": "lele",
          "text": "也可能是有人故意放在這裡，想讓別人看到。"
        },
        {
          "role": "narrator",
          "text": "就在這時，店裡的廣播響起，聲音有點吵雜。"
        },
        {
          "role": "narrator",
