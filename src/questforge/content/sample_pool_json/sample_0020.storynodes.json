    "scene_01_warmup_2": {
      "title": "開場延伸：便利商店裡的新朋友",
      "narration": [
        {
          "role": "narrator",
          "text": "就在這時，餅乾小脆提著一袋糖果走了進來。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：嘿，大家好！我剛從家裡帶了新口味的糖果來分享喔！"
        },
        {
          "role": "lele",
          "text": "哇！餅乾小脆，你怎麼總是帶這麼多好東西？"
        },
        {
          "role": "feifei",
          "text": "小脆你今天戴的帽子好可愛，是不是新買的？"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：對啊！我還貼了閃亮亮的貼紙，像小星星一樣！"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏突然跑到餅乾小脆身旁，像小尾巴一樣跟著。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我也想要貼貼紙！可不可以借我一點？"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：當然可以！我還有好多呢！"
        },
        {
          "role": "lele",
          "text": "你們兩個在講貼紙，我都想把自己貼起來了！"
        },
        {
          "role": "feifei",
          "text": "哈哈，樂樂你要小心，別被自己黏住喔！"
        },
        {
          "role": "narrator",
          "text": "阿明店員走過來，手裡拿著一盒新到的巧克力棒。"
        },
        {
          "role": "narrator",
          "text": "阿明：大家想試試這個新口味嗎？今天特價喔！"
        },
        {
          "role": "lele",
          "text": "我想要！巧克力棒是我的最愛！"
        },
        {
          "role": "feifei",
          "text": "等等，樂樂，別急著拿，先排隊喔。"
        },
        {
          "role": "lele",
          "text": "好啦好啦，我只是太興奮了！"
        },
        {
          "role": "narrator",
          "text": "店裡響起輕快的音樂，讓整個空間充滿歡樂的氣氛。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：這音樂讓我想跳舞了！"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：那我們等會兒來場舞蹈比賽吧！"
        },
        {
          "role": "feifei",
          "text": "哈哈，樂樂你準備好被我們打敗了嗎？"
        },
        {
          "role": "lele",
          "text": "哼哼，等著瞧！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_3": {
      "title": "好奇心轉場（小偵探模式啟動）",
      "narration": [
        {
          "role": "feifei",
          "text": "欸，樂樂，你剛剛說那個冰棒是冷冷的，會不會是誰剛放在那裡忘了拿？"
        },
        {
          "role": "lele",
          "text": "有可能耶！我想知道到底是誰耶。"
        },
        {
          "role": "feifei",
          "text": "我們來開啟小偵探模式好了，眼睛要亮亮的，耳朵也要聽清楚。"
        },
        {
          "role": "lele",
          "text": "好耶！我要戴上我的放大鏡帽，這樣看東西一定更清楚！"
        },
        {
          "role": "feifei",
          "text": "哈哈，你那帽子看起來像是放大鏡變成的飛碟。"
        },
        {
          "role": "lele",
          "text": "我說不定可以飛起來喔！"
        },
        {
          "role": "feifei",
          "text": "那我們就悄悄地在店裡四處看看，看看有沒有什麼特別的地方。"
        },
        {
          "role": "lele",
          "text": "你說特別的地方，是不是有什麼東西被放錯了？"
        },
        {
          "role": "feifei",
          "text": "可能是，也可能是剛剛有人動過什麼東西。"
        },
        {
          "role": "lele",
          "text": "欸？霏霏，你覺得那個冰棒會不會是誰不小心弄掉的？"
        },
        {
          "role": "feifei",
          "text": "我也不確定耶，可能是，也可能不是。"
        },
        {
          "role": "lele",
          "text": "那我們去找阿明店員問問看好了，他一定知道很多。"
        },
        {
          "role": "feifei",
          "text": "好啊，我們去問問看，說不定他剛剛有看到什麼。"
        },
        {
          "role": "lele",
          "text": "小偵探出動！走著！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_02_incident": {
      "title": "便利商店的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走向收銀台，阿明店員正忙著整理貨架。"
        },
        {
          "role": "narrator",
          "text": "阿明：嗨，小朋友們，今天看起來心情不錯喔！"
        },
        {
          "role": "lele",
          "text": "阿明，剛剛我在角落摸到一包冰棒，放在紙箱裡，這是怎麼回事？"
        },
        {
          "role": "narrator",
          "text": "阿明：哦，那包冰棒啊，剛剛有位客人買了很多東西，結果不小心把它放錯地方了。"
        },
        {
          "role": "feifei",
          "text": "是誰啊？他還有帶別的東西嗎？"
        },
        {
          "role": "narrator",
          "text": "阿明：他戴著紅色帽子，拿著一包餅乾，然後好像很匆忙地走了。"
        },
        {
          "role": "lele",
          "text": "咦？紅色帽子？我好像看到過那個人耶！"
        },
        {
          "role": "feifei",
          "text": "在哪裡？說說看你看到什麼。"
        },
        {
          "role": "lele",
          "text": "他剛剛在飲料區挑飲料，手伸來伸去，好像在找什麼。"
        },
        {
          "role": "narrator",
          "text": "阿明：嗯，他看起來有點焦急，還跟我說他趕著去學校。"
        },
        {
          "role": "narrator",
          "text": "這時候，膠帶小黏從貨架後面跑出來，手裡拿著一張小紙條。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：欸！我撿到這張紙條，好像有人掉在地上。"
        },
        {
          "role": "feifei",
          "text": "讓我看看！上面寫著什麼？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：寫著『明天下午三點，便利商店後門』，還有一個笑臉貼紙。"
        },
        {
          "role": "lele",
          "text": "這是什麼意思？像是約定還是秘密訊息？"
        },
        {
          "role": "feifei",
          "text": "也許是，也許不是，我們先收著。"
        },
        {
          "role": "narrator",
          "text": "店裡突然響起門鈴聲，門口走進一個戴著綠色帽子的男孩，手上拿著一本漫畫書。"
        },
        {
          "role": "feifei",
          "text": "那是誰？我怎麼覺得他看起來很熟悉？"
        },
        {
          "role": "lele",
          "text": "是餅乾小脆！他剛剛不是在外面嗎？"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_03_check_1": {
      "title": "飲料區的發現",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到飲料區，看到地上有一些水滴。"
        },
        {
          "role": "lele",
          "text": "欸，這些水滴是剛剛那個紅帽子男孩留下的嗎？"
        },
        {
          "role": "feifei",
          "text": "有可能，水滴看起來有點黏黏的，好像是汽水灑出來的。"
        },
        {
          "role": "narrator",
          "text": "附近的貨架上，有一瓶汽水倒在一半，瓶蓋沒蓋好。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我剛剛看到那瓶汽水，好像有點晃動過。"
        },
        {
          "role": "lele",
          "text": "這瓶汽水會不會是他不小心碰倒的？"
        },
        {
          "role": "feifei",
          "text": "也許是，也許不是，我們先看看還有什麼。"
        },
        {
          "role": "narrator",
          "text": "店員阿明走過來，拿起一張濕濕的收據，皺著眉頭。"
        },
        {
          "role": "narrator",
          "text": "阿明：這張收據有點濕，剛剛好像有人在這裡忙著付錢。"
        },
        {
          "role": "feifei",
          "text": "收據上寫的是什麼？"
        },
        {
          "role": "narrator",
          "text": "阿明：寫著買了兩瓶汽水和一包餅乾。"
        },
        {
          "role": "lele",
          "text": "那包餅乾會不會就是餅乾小脆剛才拿的？"
        },
        {
          "role": "feifei",
          "text": "可能是耶，我們再去問問他。"
        },
        {
          "role": "narrator",
          "text": "樂樂蹲在地上，摸到一小塊皺皺的糖果包裝紙。"
        },
        {
          "role": "lele",
          "text": "欸？這個糖果包裝紙掉在地上，好像被踩過。"
        },
        {
          "role": "feifei",
          "text": "糖果包裝紙？剛剛那個餅乾小脆有沒有糖果？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我記得他說他帶了新口味的糖果來！"
        },
        {
          "role": "narrator",
          "text": "霏霏和樂樂交換了一個眼神，繼續往店裡深處走去。"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
          "next": "scene_04_check_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_04_check_2": {
      "title": "零食架旁的細節",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到零食架旁，看到一包餅乾的位置被稍微挪動過。"
        },
        {
          "role": "lele",
          "text": "欸，這包餅乾好像不是放得很整齊，旁邊還有點黏黏的東西。"
        },
        {
          "role": "feifei",
          "text": "黏黏的？你摸摸看是什麼感覺？"
        },
        {
          "role": "lele",
          "text": "有點像是糖漿或蜂蜜，黏黏又甜甜的。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我剛剛聽到『啪』的一聲，好像是包裝袋被撕開的聲音。"
        },
        {
          "role": "feifei",
          "text": "那可能有人剛剛在這裡吃東西？"
        },
        {
          "role": "lele",
          "text": "不過餅乾小脆剛剛在外面，他會不會回來吃？"
        },
        {
          "role": "feifei",
          "text": "也許他只是順手拿了東西，還沒吃完。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏蹲下，看到地上有一塊皺皺的紙屑。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：這是糖果包裝紙的角角，應該是剛剛那個糖果掉的。"
        },
        {
          "role": "lele",
          "text": "我覺得有點怪怪的，為什麼糖果包裝紙會掉在這裡？"
        },
        {
          "role": "feifei",
          "text": "嗯……也許有人不小心掉了，或者是故意放在那裡。"
        },
        {
          "role": "narrator",
          "text": "就在這時，餅乾小脆走過來，手上還拿著他的漫畫書。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：你們在找什麼啊？我剛剛看到有人在這裡翻找東西耶！"
        },
        {
          "role": "lele",
          "text": "真的嗎？是誰啊？"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：我沒看清楚，不過他戴著藍色帽子，好像是隔壁班的同學。"
        }
      ],
      "choices": [
        {
          "text": "換個地方看看",
          "next": "scene_05_check_3",
          "enabled": true,
