    "scene_01_start": {
      "title": "開場：文具店的熱鬧日常",
      "narration": [
        {
          "role": "narrator",
          "text": "今天是學校舉辦的文具市集，大家都在學校旁邊的小文具店裡挑選自己喜歡的東西。"
        },
        {
          "role": "narrator",
          "text": "文具店裡擺滿了各種彩色筆、貼紙和筆記本，空氣中有淡淡的鉛筆香味。"
        },
        {
          "role": "narrator",
          "text": "霏霏和樂樂跟著同學們一起來到文具店，準備挑選新學期需要的用品。"
        },
        {
          "role": "feifei",
          "text": "欸，樂樂，你看那邊的橡皮擦有好多顏色喔！"
        },
        {
          "role": "lele",
          "text": "我想要那個有小動物圖案的，超可愛的！"
        },
        {
          "role": "narrator",
          "text": "店裡還有兩位小幫手在忙碌，一個是戴著藍色髮箍的膠帶小黏，另一個是手裡拿著餅乾形狀筆記本的餅乾小脆。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：今天的貼紙款式好多喔，大家一定會喜歡！"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：我剛剛還試著把筆記本蓋反了，差點變成筆記本怪獸！"
        },
        {
          "role": "feifei",
          "text": "哈哈，筆記本怪獸？你會不會想太多了。"
        },
        {
          "role": "lele",
          "text": "我覺得餅乾小脆比較像餅乾怪獸啦！"
        },
        {
          "role": "narrator",
          "text": "店裡的吊燈發出溫暖的光，照亮了每個角落，也照亮了孩子們的笑臉。"
        },
        {
          "role": "feifei",
          "text": "店裡的鉛筆盒好像都在比賽誰最會跳舞耶，你看那個紅色的鉛筆盒搖來搖去。"
        },
        {
          "role": "lele",
          "text": "欸欸，那個鉛筆盒是在跳街舞嗎？我也要跟它比比看！"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：小心別把鉛筆盒跳壞了，不然我又要忙著貼膠帶了。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：我先去幫忙整理貼紙區，大家慢慢挑！"
        },
        {
          "role": "feifei",
          "text": "樂樂，你剛剛手上那支筆怎麼感覺黏黏的？"
        },
        {
          "role": "lele",
          "text": "欸？真的耶！我剛剛好像摸到有點黏的地方。"
        },
        {
          "role": "feifei",
          "text": "黏黏的？你摸哪裡？"
        },
        {
          "role": "lele",
          "text": "就是這支筆的筆蓋，摸起來像有點黏黏的糖果殘留。"
        },
        {
          "role": "narrator",
          "text": "文具店外傳來悠閒的鳥叫聲，讓這個小小的空間更顯得溫馨。"
        },
        {
          "role": "feifei",
          "text": "我想我們可以小心看看這支筆，說不定有什麼有趣的故事藏在這裡呢。"
        },
        {
          "role": "lele",
          "text": "好耶！小偵探模式啟動，我們的眼睛要亮亮的！"
        },
        {
          "role": "feifei",
          "text": "對啊，偷偷用放大鏡看一看，說不定會看到什麼不一樣的東西！"
        },
        {
          "role": "lele",
          "text": "我覺得這支筆好像有點神秘，像是有秘密要告訴我們！"
        },
        {
          "role": "feifei",
          "text": "哈哈，那我們就去看看這支筆到底發生了什麼吧！"
        }
      ],
      "choices": [
        {
          "text": "繼續",
          "next": "scene_01_warmup_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_2": {
      "title": "開場延伸：文具店的趣事",
      "narration": [
        {
          "role": "narrator",
          "text": "膠帶小黏突然發現桌上多了一捲彩色膠帶，摸起來有點皺皺的。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：咦？這捲膠帶怎麼感覺有點不一樣，好像被揉過？"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：哈哈，可能是膠帶怪獸來過吧！"
        },
        {
          "role": "feifei",
          "text": "膠帶怪獸？那它會不會偷偷貼著膠帶跑來跑去啊？"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
