    "scene_02_incident": {
      "title": "案件發生：泳池邊的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "泳池邊突然傳來一陣小騷動，大家的目光都往毛巾那邊看去。"
        },
        {
          "role": "narrator",
          "text": "有人發現藍色毛巾旁邊的游泳圈被挪動了位置。"
        },
        {
          "role": "lele",
          "text": "欸，我看到那個橘色游泳圈好像被挪到旁邊去了耶！"
        },
        {
          "role": "feifei",
          "text": "奇怪，剛剛我們明明看到它是放在椅子上，現在怎麼變成在地上了？"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵和餅乾小脆也走了過來，臉上有點疑惑。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我剛剛去拿水，游泳圈還在椅子上啊。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：我也看到的，剛才還有人坐在那附近玩水槍。"
        },
        {
          "role": "lele",
          "text": "怪怪的，為什麼會動呢？"
        },
        {
          "role": "feifei",
          "text": "我們用眼睛和耳朵好好看看，說不定會發現什麼呢！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
