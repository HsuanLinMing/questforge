    "scene_01_warmup_2": {
      "title": "開場延伸：游泳池邊的趣事",
      "narration": [
        {
          "role": "narrator",
          "text": "泳池旁的小販車賣著冰淇淋，膠帶小黏正站在那邊挑選口味。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我要巧克力口味，因為我喜歡黏黏的感覺。"
        },
        {
          "role": "lele",
          "text": "黏黏的巧克力？聽起來像黏土耶！"
        },
        {
          "role": "feifei",
          "text": "哈哈，樂樂你要不要拿黏土來玩？"
        },
        {
          "role": "narrator",
          "text": "泳池邊傳來孩子們的笑聲和水花聲，像小鼓點一樣跳躍著。"
        },
        {
          "role": "feifei",
          "text": "你看那邊，橡皮小方正在教大家怎麼做水中翻滾。"
        },
        {
          "role": "lele",
          "text": "我也想學，可是我還不會游泳。"
        },
        {
          "role": "feifei",
          "text": "沒關係，我們慢慢來，先從玩水開始。"
        },
        {
          "role": "narrator",
          "text": "泳池邊的風扇轉得呼呼響，吹來一股涼涼的風，帶著泳池的水氣味。"
        },
        {
          "role": "lele",
          "text": "這風扇轉得像大風車，差點把我的帽子吹飛。"
        },
        {
          "role": "feifei",
          "text": "哈哈，你的帽子會飛走就像小鳥一樣自由了。"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_3": {
      "title": "好奇心轉場（小偵探模式）",
      "narration": [
        {
          "role": "feifei",
          "text": "欸欸，樂樂，你剛剛看到泳池邊那個藍色毛巾旁邊，好像有什麼東西掉在地上耶。"
        },
        {
          "role": "lele",
          "text": "真的耶，我看到一個小小的東西，像是黏黏的膠帶尾巴。"
        },
        {
          "role": "feifei",
          "text": "膠帶尾巴？那會不會是膠帶小黏的？"
        },
        {
          "role": "lele",
          "text": "我想知道它怎麼會掉在那裡，這件事有點讓我眼睛亮亮的，好像有秘密藏在裡面。"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
