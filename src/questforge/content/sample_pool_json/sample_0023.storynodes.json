    "scene_10_ending_nudge": {
      "title": "結尾（選擇膠帶小黏）",
      "narration": [
        {
          "role": "narrator",
          "text": "膠帶小黏剛好踩到黏黏的糖漿，讓帽子變得黏黏的。"
        },
