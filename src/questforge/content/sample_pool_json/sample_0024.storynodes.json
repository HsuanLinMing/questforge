    "scene_01_warmup_3": {
      "title": "好奇心轉場（小偵探模式啟動）",
      "narration": [
        {
          "role": "narrator",
          "text": "樂樂忽然注意到牆上有一幅畫，畫裡的恐龍眼睛好像動了一下。"
        },
        {
          "role": "lele",
          "text": "咦？那幅畫的恐龍眼睛好像眨了一下耶！"
        },
        {
          "role": "feifei",
          "text": "真的假的啦！你是不是看太多恐龍電影，開始幻想了？"
        },
        {
          "role": "lele",
          "text": "我可是小偵探，眼睛亮亮的，什麼都看得出來！"
        },
        {
          "role": "feifei",
          "text": "那我們就用小偵探模式，去看看這裡有什麼特別的地方吧！"
        },
        {
          "role": "lele",
          "text": "好啊，我們一起去找找看！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
