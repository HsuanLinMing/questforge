    "scene_02_incident": {
      "title": "車站裡的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走近那個藍制服哥哥，發現他正蹲在月台邊緣，旁邊有幾張彩色貼紙散落在地上。"
        },
        {
          "role": "lele",
          "text": "欸，這些貼紙怎麼會掉在這裡？"
        },
        {
          "role": "feifei",
          "text": "我聽到旁邊有人說，『我剛剛放在這裡的貼紙怎麼會跑出來？』"
        },
        {
          "role": "narrator",
          "text": "附近的紅帽阿姨也皺起眉頭，似乎在找什麼東西。"
        },
        {
          "role": "narrator",
          "text": "紅帽阿姨：我剛剛放在包包裡的貼紙，好像少了一些。"
        },
        {
          "role": "narrator",
          "text": "藍制服哥哥抬頭看了看四周，然後輕輕嘆氣。"
        },
        {
          "role": "narrator",
          "text": "藍制服哥哥：我也不知道怎麼會掉出來的，剛剛明明放好好的。"
        },
        {
          "role": "feifei",
          "text": "看來有點小狀況，我們來仔細看看這些貼紙吧！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_03_check_1": {
      "title": "第一個觀察：地上的貼紙",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏蹲下來，伸手摸了摸地上的貼紙。"
        },
        {
          "role": "feifei",
          "text": "欸，這些貼紙摸起來黏黏的，好像剛被撕下來。"
        },
        {
          "role": "lele",
          "text": "我看到貼紙的邊邊有點皺皺的，好像有人用力撕過。"
        },
        {
          "role": "narrator",
          "text": "店員阿布：我剛剛聽到『啪』一聲，像是貼紙被撕開的聲音。"
        },
        {
          "role": "feifei",
          "text": "貼紙掉在這裡，可能是剛剛有人不小心碰掉的吧？"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
          "next": "scene_04_check_2",
