    "scene_01_warmup_2": {
      "title": "開場延伸：更多車站趣事",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂悄悄走近布偶旁邊，發現裡面站著一個穿著藍色制服的哥哥。"
        },
        {
          "role": "lele",
          "text": "欸，那個哥哥手裡拿著一張車票，好像在找東西。"
        },
        {
          "role": "feifei",
          "text": "他好像在看地上的什麼東西，蹲著不動。"
        },
        {
          "role": "narrator",
          "text": "店員阿布：欸，你們在看什麼呢？小心別踩到地上的小石子喔。"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
