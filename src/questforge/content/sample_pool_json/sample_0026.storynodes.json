    "scene_02_incident": {
      "title": "公園裡的新狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "當霏霏和樂樂走近那片草地時，看到幾個小朋友圍著什麼東西小聲說話。"
        },
        {
          "role": "lele",
          "text": "欸，那邊發生什麼事？"
        },
        {
          "role": "feifei",
          "text": "我們去看看，好奇寶寶模式開啟！"
        },
        {
          "role": "narrator",
          "text": "小朋友們指著草地上的一個小盒子，盒子蓋子微微開著，看起來像是被放錯地方了。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我剛剛沒有看到這個盒子，怎麼會在這裡呢？"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：盒子上還有一片皺皺的貼紙，像是剛撕下來的。"
        },
        {
          "role": "lele",
          "text": "怪怪的，這盒子怎麼會出現在這裡？"
        },
        {
          "role": "feifei",
          "text": "嗯，可能是有人忘記放回去，或者……也許是被風吹過來的？"
        },
        {
          "role": "lele",
          "text": "好像有點像迷路的盒子喔！"
        },
        {
          "role": "feifei",
          "text": "哈哈，迷路的盒子？那我們得幫它找到家了！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_03_check_1": {
      "title": "第一個觀察點：草地上的小盒子",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏蹲下身仔細看著盒子，盒子表面有些刮痕，還沾著幾片落葉。"
        },
        {
          "role": "feifei",
          "text": "欸，盒子上還有一點點黏黏的東西，是什麼呢？"
        },
        {
          "role": "lele",
          "text": "我摸摸看，嗯……有點像是膠帶的黏膠，還有一點點泥土。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：欸，那應該是我剛剛修理秋千時用的膠帶碎片吧！"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：可是這盒子怎麼會在這裡？我記得我們剛剛在另一邊玩耍。"
        },
        {
          "role": "lele",
          "text": "還有草地上有幾個不太整齊的腳印，好像有人匆忙走過。"
        },
        {
          "role": "feifei",
          "text": "嗯，這些腳印看起來像是小朋友的鞋子，鞋底有花紋。"
        },
        {
          "role": "lele",
          "text": "我覺得這可能跟剛剛的盒子有關，但又怪怪的。"
        },
        {
          "role": "feifei",
          "text": "怪怪的？你看到什麼怪怪的？"
        },
        {
          "role": "lele",
          "text": "就是腳印方向好像亂掉了，像是有人走錯路。"
        },
        {
          "role": "feifei",
          "text": "嗯嗯，我們再多看看，偵探模式不能急。"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
          "next": "scene_04_check_2",
          "enabled": true,
          "tag": ""
        }
      ],
