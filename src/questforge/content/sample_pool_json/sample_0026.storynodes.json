    "scene_01_warmup_2": {
      "title": "開場延伸：更多公園小故事",
      "narration": [
        {
          "role": "narrator",
          "text": "這時，餅乾小脆跑過來，手裡拿著一個小小的風箏。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：你們看我新買的風箏，好像一隻大蝴蝶！"
        },
        {
          "role": "lele",
          "text": "哇！好漂亮喔！我也想放風箏！"
        },
        {
          "role": "feifei",
          "text": "欸欸，風箏線要小心別纏到別人喔，別像上次那樣。"
        },
        {
          "role": "lele",
          "text": "哈哈，我記得上次膠帶小黏差點被風箏線綁成蝴蝶結！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
