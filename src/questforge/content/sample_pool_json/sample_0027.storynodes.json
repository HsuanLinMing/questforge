    "scene_05_check_3": {
      "title": "海邊遊戲區的小發現",
      "narration": [
        {
          "role": "narrator",
          "text": "他們來到海邊的遊戲區，看到一些小朋友在玩沙子和水。"
        },
        {
          "role": "lele",
          "text": "欸，這裡有個小桶子，裡面裝著一些五顏六色的貝殼。"
        },
        {
          "role": "feifei",
          "text": "桶子旁邊有幾塊濕濕的海藻，摸起來滑滑的。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我看見有人把沙鏟放在地上，好像剛剛挖了個坑。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我剛剛聽到「咕嚕咕嚕」的聲音，像是水流動的聲音。"
        },
        {
          "role": "lele",
          "text": "欸欸，我看到那邊有個小螃蟹，牠好像拿著一片塑膠袋在爬耶！"
        },
        {
          "role": "feifei",
          "text": "塑膠袋？會不會是剛剛那片碎片的朋友？"
        },
        {
          "role": "lele",
          "text": "哈哈，塑膠袋變成海邊的秘密武器了！"
        }
      ],
      "choices": [
        {
          "text": "我有一個猜想",
          "next": "scene_06_hypothesis_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
