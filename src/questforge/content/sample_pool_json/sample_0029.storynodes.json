    "scene_10_ending_nudge": {
      "title": "結尾（猜測二）",
      "narration": [
        {
          "role": "narrator",
          "text": "媽媽：謝謝你們分享觀察。"
        },
        {
          "role": "narrator",
          "text": "媽媽：其實珍珠奶茶是攤位阿姨放在桌上，剛好被拿著橡皮小方的小男孩旁邊的朋友不小心碰到。"
        },
        {
          "role": "narrator",
          "text": "媽媽：所以弄得有點亂。"
        },
        {
          "role": "narrator",
          "text": "媽媽：對不起讓大家擔心了。"
        },
