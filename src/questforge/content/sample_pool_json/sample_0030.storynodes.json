  "nodes": {
    "scene_01_start": {
      "title": "開場：便利商店的熱鬧早晨",
      "narration": [
        {
          "role": "narrator",
          "text": "今天早上，霏霏和樂樂來到了附近的便利商店。"
        },
        {
          "role": "narrator",
          "text": "店裡擺滿了各種零食和飲料，還有那台一直叮叮響的自動收銀機。"
        },
        {
          "role": "narrator",
          "text": "店裡除了他們，還有兩個小朋友在選糖果：飯糰啵啵和膠帶小黏。"
        },
        {
          "role": "feifei",
          "text": "欸，樂樂，你看那個新口味的果汁，好像很好喝耶！"
        },
        {
          "role": "lele",
          "text": "我想喝那個藍色的！喝了會不會變藍色啊？"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我在找我的最愛—辣味魚乾，怎麼架子上好像少了幾包？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我剛剛看到有人拿了一包，可是他好像沒付錢耶。"
        },
        {
          "role": "feifei",
          "text": "欸欸欸，先不要亂說話啦，大家都在看著呢。"
        },
        {
          "role": "lele",
          "text": "（小聲）我覺得那個架子旁邊好像有什麼黏黏的東西耶。"
        },
        {
          "role": "feifei",
          "text": "黏黏的？你摸到了嗎？"
        },
        {
          "role": "lele",
          "text": "還沒啦，我剛剛只是看到地上有一點亮亮的東西。"
        },
        {
          "role": "narrator",
          "text": "店員阿珍正在整理冰箱裡的冰淇淋，偶爾抬頭看了一眼大家。"
        },
        {
          "role": "narrator",
          "text": "店員阿珍：小朋友們，記得排隊結帳喔，不要擠啊！"
        },
        {
          "role": "lele",
          "text": "我排隊排得很棒耶！我連腳都不亂動。"
        },
        {
          "role": "feifei",
          "text": "你那叫腳麻。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵和膠帶小黏開始聊起他們昨天在公園看到的小松鼠。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：那隻松鼠超愛偷堅果，結果被松果砸到頭，好好笑。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：松鼠會痛嗎？我覺得它應該會說「哎呦！」"
        },
        {
          "role": "feifei",
          "text": "哈哈哈，你想像力真豐富。"
        },
        {
          "role": "lele",
          "text": "欸，我剛剛看到隔壁櫃的糖果袋子好像被動過耶，袋子邊邊皺皺的。"
        },
        {
          "role": "feifei",
          "text": "皺皺的？你是說像被揉過還是被壓過？"
        },
        {
          "role": "lele",
          "text": "可能是被揉過吧，因為上面還有一點黏黏的東西，像是糖漿。"
        },
        {
          "role": "narrator",
          "text": "阿珍把一瓶飲料放回冰箱，冰箱門還發出輕輕的嗡嗡聲。"
        },
        {
          "role": "narrator",
          "text": "店員阿珍：今天的飲料特價喔，買一送一，大家別錯過了！"
        },
        {
          "role": "feifei",
          "text": "哇，買一送一！樂樂，你要不要多買幾瓶？"
        },
        {
          "role": "lele",
          "text": "我要買十瓶！這樣我就可以天天喝藍色飲料變藍了！"
        },
        {
          "role": "narrator",
          "text": "這時候，膠帶小黏突然發現什麼，眼睛瞪得大大的。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：欸欸，你們看！那邊角落的糖果罐子蓋子好像沒蓋好，有點歪歪的。"
        },
        {
          "role": "feifei",
          "text": "真的耶，那個罐子裡面還有幾顆糖果滾來滾去的聲音。"
        },
        {
          "role": "lele",
          "text": "會不會是有人剛剛偷偷拿過？"
        },
        {
          "role": "feifei",
          "text": "欸欸，不要亂猜啦，我們先用眼睛和耳朵好好看看。"
        },
        {
          "role": "lele",
          "text": "好啦好啦，我只是說說而已。"
        },
        {
          "role": "narrator",
          "text": "霏霏瞇起眼睛，像小偵探一樣觀察著四周，眼睛亮亮的。"
        },
        {
          "role": "feifei",
          "text": "我們來玩放大鏡模式，看看這裡還有什麼有趣的東西。"
        },
        {
          "role": "lele",
          "text": "我也要玩！我的眼睛已經像望遠鏡一樣大了！"
        },
        {
          "role": "narrator",
          "text": "大家都安靜下來，開始仔細觀察店裡的每個角落，準備發現一些秘密。"
        },
        {
          "role": "feifei",
          "text": "欸欸，樂樂，你覺得這裡面會不會藏著什麼小秘密呢？"
        },
        {
          "role": "lele",
          "text": "我猜可能有糖果大軍在這裡開派對喔！"
        }
      ],
      "choices": [
        {
          "text": "繼續",
          "next": "scene_01_warmup_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_2": {
      "title": "開場延伸：便利商店的小插曲",
      "narration": [
        {
          "role": "narrator",
          "text": "突然，飯糰啵啵不小心碰到了貨架上的餅乾袋子，發出「咚」的一聲。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：哎呀！差點當場餵地板一包餅乾了。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：哈哈哈，餅乾如果會說話，應該會說「救命啊！」吧？"
        },
        {
          "role": "feifei",
          "text": "樂樂，你看你旁邊的飲料瓶，標籤貼得歪歪的，好像被誰偷偷調皮過。"
        },
        {
          "role": "lele",
          "text": "真的欸，會不會是飲料瓶自己想要換個造型？"
        },
        {
          "role": "narrator",
          "text": "店員阿珍：小朋友，別亂動商品喔，大家都想買呢！"
        },
        {
          "role": "feifei",
          "text": "阿珍姐，這裡的冰淇淋味道真的好多耶，我想試試看那個新口味。"
        },
        {
          "role": "narrator",
          "text": "店員阿珍：等會兒喔，冰淇淋要排隊拿，不可以插隊喔！"
        },
        {
          "role": "lele",
          "text": "我排隊排得像火箭一樣快！"
        },
        {
          "role": "feifei",
          "text": "火箭？你會不會太快，飛出店門了？"
        },
        {
          "role": "lele",
          "text": "哈哈，那我就變成飛天樂樂了！"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：欸欸，我剛剛看到門口那隻小狗，好像在看我們耶。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：小狗會不會是在等主人買零食給它？"
        },
        {
          "role": "feifei",
          "text": "嗯…我覺得小狗可能在想要不要偷偷溜進來。"
        },
        {
          "role": "lele",
          "text": "不行！小狗會把冰淇淋吃光光！"
        },
        {
          "role": "narrator",
          "text": "店裡的氛圍熱鬧又輕鬆，大家都在享受這個平常的早晨。"
        },
        {
          "role": "feifei",
          "text": "欸，我覺得我們應該再用眼睛多看看四周，說不定會發現什麼有趣的事。"
        },
        {
          "role": "lele",
          "text": "好啊！那我開啟我的超級偵探模式！"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：超級偵探模式？聽起來好酷！"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：那我就是餅乾獵人，專門找掉落的餅乾屑！"
        },
        {
          "role": "feifei",
          "text": "哈哈哈，餅乾獵人，我看你是餅乾小偷啦！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_3": {
      "title": "好奇心轉場：小偵探模式啟動",
      "narration": [
        {
          "role": "feifei",
          "text": "樂樂，你剛剛說看到地上有亮亮的東西，我覺得我們應該仔細看看。"
        },
        {
          "role": "lele",
          "text": "對啊，我的眼睛已經亮晶晶的，像有放大鏡一樣。"
        },
        {
          "role": "narrator",
          "text": "兩個小朋友蹲下身子，開始用眼睛仔細掃描地上的細節。"
        },
        {
          "role": "feifei",
          "text": "欸欸，這裡的糖果罐旁邊，好像有一點黏黏的東西耶，摸起來涼涼的。"
        },
        {
          "role": "lele",
          "text": "我想像那是糖果怪獸的口水！"
        },
        {
          "role": "feifei",
          "text": "哈哈哈，糖果怪獸？那它會不會因為糖太甜，笑得合不攏嘴？"
        },
        {
          "role": "lele",
          "text": "我要是糖果怪獸，我一定每天笑哈哈！"
        },
        {
          "role": "feifei",
          "text": "好啦，我們先用眼睛和耳朵再多看看這裡，說不定會有更有趣的發現。"
        },
        {
          "role": "lele",
          "text": "沒錯！小偵探模式啟動！眼睛亮亮，耳朵豎豎！"
        },
        {
          "role": "narrator",
          "text": "店裡的聲音似乎也變得清晰起來，連冰箱的嗡嗡聲都像在說話一樣。"
        },
        {
          "role": "feifei",
          "text": "我們來偷偷觀察，看看有沒有什麼特別的地方。"
        },
        {
          "role": "lele",
          "text": "我準備好啦！讓我看看這個小秘密藏在哪裡！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_02_incident": {
      "title": "案件發生：便利商店的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "正當大家聚精會神地觀察時，店門口突然傳來一陣小聲的爭吵聲。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵皺起眉頭，低聲說：「我剛剛放在架子上的巧克力，好像被挪動了。」"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏也說：「我記得那瓶果汁是在這裡，現在怎麼變到另一排了？」"
        },
        {
          "role": "feifei",
          "text": "欸欸欸，這是什麼狀況？大家的東西都動來動去的嗎？"
        },
        {
          "role": "lele",
          "text": "我剛剛聽到有人腳步聲，好像從這邊走過去……"
        },
        {
          "role": "narrator",
          "text": "店員阿珍：大家別吵，先冷靜，不要擠來擠去喔。"
        },
        {
          "role": "feifei",
          "text": "我覺得我們可以用眼睛和耳朵好好看看，看看到底發生了什麼。"
        },
        {
          "role": "lele",
          "text": "我也想知道，這些東西到底是怎麼跑來跑去的。"
        },
        {
          "role": "narrator",
          "text": "店裡的氣氛突然變得有點安靜，每個人都開始注意四周的小細節。"
        },
        {
          "role": "feifei",
          "text": "好啦，我們先不急著猜，先用小偵探的眼睛看看。"
        },
        {
          "role": "lele",
          "text": "我的眼睛已經準備好了！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_03_check_1": {
      "title": "第一個觀察：巧克力架上的變化",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到巧克力架旁邊，看著那一排排整齊擺放的巧克力。"
        },
        {
          "role": "lele",
          "text": "欸，你們看，這一包巧克力旁邊的包裝有點皺皺的，好像被人摸過。"
        },
        {
          "role": "feifei",
          "text": "皺皺的？你摸摸看味道有沒有不一樣。"
        },
        {
          "role": "lele",
          "text": "嗯……沒有什麼特別味道，就是有點黏黏的。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我剛剛放的巧克力應該是這裡沒錯，可是怎麼會變成這樣？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我剛剛聽到旁邊有「啪」一聲，好像是包裝被撕開的聲音。"
        },
        {
          "role": "feifei",
          "text": "嗯，這個聲音很有趣耶，我們再聽聽看其他地方有沒有類似的聲音。"
        },
        {
          "role": "lele",
          "text": "我覺得巧克力架旁邊的地板有點黏黏的，好像有人不小心滴了什麼東西。"
        },
        {
          "role": "feifei",
          "text": "黏黏的地板？那可能是巧克力融化了？"
        },
        {
          "role": "lele",
          "text": "或是糖果怪獸的口水啦！"
        },
        {
          "role": "feifei",
          "text": "哈哈哈，樂樂你又想像了。"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
          "next": "scene_04_check_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_04_check_2": {
      "title": "第二個觀察：果汁架的新發現",
      "narration": [
        {
          "role": "narrator",
          "text": "接著，兩人走到果汁架前，發現那瓶被說成移動的果汁。"
        },
        {
          "role": "lele",
          "text": "你們看這瓶果汁的標籤，有點歪掉了，好像被人拿起來又放下去。"
        },
        {
          "role": "feifei",
          "text": "標籤歪了？那瓶果汁摸起來冰冰涼涼的。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我剛剛聽到架子上有輕輕的碰撞聲，好像有人把瓶子放回去的聲音。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：可是我明明記得那瓶果汁剛剛不在這裡耶。"
        },
        {
          "role": "lele",
          "text": "欸欸，架子旁邊有個小紙條，好像是店員忘了收走的。"
        },
        {
          "role": "feifei",
          "text": "紙條？上面寫了什麼？"
        },
        {
          "role": "lele",
          "text": "上面寫著「請勿亂動貨架，謝謝合作！」"
        },
        {
          "role": "feifei",
          "text": "哈哈哈，這張紙條好像在跟我們說話耶。"
        },
        {
          "role": "lele",
          "text": "貨架也會生氣嗎？"
        },
        {
          "role": "feifei",
          "text": "欸，可能會吧，尤其是被揉皺的標籤。"
        },
        {
          "role": "narrator",
          "text": "兩人又聽到一陣輕輕的笑聲，像是誰在偷笑一樣。"
        }
      ],
      "choices": [
        {
          "text": "換個地方看看",
