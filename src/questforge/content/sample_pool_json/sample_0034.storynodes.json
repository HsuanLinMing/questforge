    "scene_01_start": {
      "title": "開場：校園才藝日的熱鬧",
      "narration": [
        {
          "role": "narrator",
          "text": "今天是學校一年一度的才藝日，教室裡擺滿了各種彩色的布條和氣球。"
        },
        {
          "role": "narrator",
          "text": "大家正在準備表演，有的在練習唱歌，有的在排舞蹈隊形。"
        },
        {
          "role": "narrator",
          "text": "霏霏和樂樂也在教室裡，準備他們的魔術表演。"
        },
        {
          "role": "feifei",
          "text": "欸，樂樂，你的帽子怎麼歪了？像個倒下去的蘑菇。"
        },
        {
          "role": "lele",
          "text": "我在練習變魔術，帽子要有點神秘感！"
        },
        {
          "role": "narrator",
          "text": "這時候，飯糰啵啵和膠帶小黏也走了進來，他們是班上的小幫手。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：你們看我帶了什麼，最新的彩色筆！"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：那我帶了超黏的膠帶，表演用！"
        },
        {
          "role": "feifei",
          "text": "哇，膠帶小黏，你的膠帶看起來像有魔法似的，黏得很厲害。"
        },
        {
          "role": "lele",
          "text": "我要用膠帶把帽子黏好，這樣就不會倒了！"
        },
        {
          "role": "narrator",
          "text": "老師走進教室，手裡拿著一張表演順序表。"
        },
        {
          "role": "teacher",
          "text": "大家注意，表演將從操場開始，請準備好道具和心情！"
        },
        {
          "role": "feifei",
          "text": "操場上有好多彩帶，感覺像彩虹躺在地上。"
        },
        {
          "role": "lele",
          "text": "我想像自己是彩虹上的小精靈，飛來飛去！"
        },
        {
          "role": "narrator",
          "text": "走廊裡傳來笑聲，是餅乾小脆和橡皮小方在玩跳繩。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：快看，我跳得像兔子一樣輕巧！"
        },
        {
          "role": "narrator",
          "text": "橡皮小方：我差點被繩子絆倒了，差點變成翻滾的麵包！"
        },
        {
          "role": "feifei",
          "text": "哈哈，橡皮小方，翻滾的麵包聽起來好好笑！"
        },
        {
          "role": "lele",
          "text": "欸，我覺得跳繩比魔術還難耶，我的帽子都快飛走了！"
        },
        {
          "role": "feifei",
          "text": "你那帽子是想飛去哪裡啊？跟我們一起看表演吧！"
        },
        {
          "role": "narrator",
          "text": "這時候，操場上突然傳來一聲輕輕的「啪」聲，好像有人踩到什麼東西。"
        },
        {
          "role": "feifei",
          "text": "欸，你聽到了嗎？那聲音好像從操場那邊傳來。"
        },
        {
          "role": "lele",
          "text": "我們去看看吧！小偵探模式啟動！"
        },
        {
          "role": "feifei",
          "text": "對啊，眼睛亮亮，耳朵豎起來，來去當小小偵探！"
        }
      ],
      "choices": [
        {
          "text": "繼續",
          "next": "scene_01_warmup_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_2": {
      "title": "開場延伸：操場的熱鬧與小插曲",
      "narration": [
        {
          "role": "narrator",
          "text": "操場上，同學們正在練習舞蹈，彩帶隨風飄揚，像一條條彩色的蛇。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏蹲在地上，仔細看著地上的一小片透明膠帶。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：欸？這膠帶怎麼黏得這麼奇怪？像是被揉過一樣。"
        },
        {
          "role": "lele",
          "text": "哈哈，膠帶小黏，你要不要試試用膠帶做一個魔法帽？"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_3": {
      "title": "好奇心轉場（小偵探模式）",
      "narration": [
        {
          "role": "feifei",
          "text": "欸，我剛剛看到有人把椅子往旁邊挪了一點，好像在找什麼東西。"
        },
        {
          "role": "lele",
          "text": "真的欸，那個位置看起來怪怪的，好像少了什麼？"
        },
        {
          "role": "feifei",
          "text": "我們先不要急著說什麼，先用眼睛和耳朵仔細看看吧！"
        },
        {
          "role": "lele",
          "text": "小偵探模式啟動！我們的眼睛要亮亮的，像放大鏡一樣！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_02_incident": {
      "title": "案件發生（需要弄清楚的狀況）",
      "narration": [
        {
          "role": "narrator",
          "text": "操場邊，幾位同學圍著一張桌子，臉上帶著困惑的表情。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏指著桌上的一個空位，說著什麼。"
        },
        {
          "role": "lele",
          "text": "欸，膠帶小黏說她剛剛把貼紙放在這裡，現在好像不見了。"
        },
        {
          "role": "feifei",
          "text": "有人皺著眉頭看著桌面，好像在想著剛剛發生了什麼。"
        },
        {
          "role": "narrator",
          "text": "大家開始輕聲討論，氣氛變得有點安靜。"
        },
        {
          "role": "lele",
          "text": "我們要不要一起看看發生了什麼事？"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
