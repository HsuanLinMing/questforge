    "scene_04_check_2": {
      "title": "第二個觀察：換個角度看操場",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到操場另一邊，想從不同角度看看桌子附近。"
        },
        {
          "role": "feifei",
          "text": "欸，桌子旁邊有一個小鞋印，像是新踩上去的。"
        },
        {
          "role": "lele",
          "text": "鞋印？我記得那是餅乾小脆的鞋子款式耶！"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：我剛剛有去拿水瓶，可能踩到那裡了。"
        },
        {
          "role": "feifei",
          "text": "欸，我聽到有人說剛剛有摔倒的聲音，好像「啪」一聲。"
        }
      ],
      "choices": [
        {
          "text": "換個地方看看",
          "next": "scene_05_check_3",
          "enabled": true,
          "tag": ""
        }
      ],
