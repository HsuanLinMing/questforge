    "scene_10_ending_defer": {
      "title": "結尾（交給大人）",
      "narration": [
        {
          "role": "narrator",
          "text": "大家回到了教室，老師和家長都來幫忙處理這件事。"
        },
        {
          "role": "narrator",
          "text": "原來是因為貼紙不小心掉在地上，大家都沒注意到。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我真的沒有故意拿走貼紙，對不起讓大家擔心了。"
        },
        {
          "role": "feifei",
          "text": "膠帶小黏，下次要更小心，這樣才不會誤會別人。"
        },
        {
          "role": "teacher",
          "text": "以後遇到疑問，記得先冷靜，互相幫助找答案。"
