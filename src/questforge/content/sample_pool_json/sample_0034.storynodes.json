    "scene_05_check_3": {
      "title": "第三個觀察：誤會的小膠帶怪物",
      "narration": [
        {
          "role": "narrator",
          "text": "樂樂蹲下來，看見地上有一團皺皺的膠帶碎片。"
        },
        {
          "role": "lele",
          "text": "欸？這個膠帶碎片看起來怪怪的，像個小怪物耶！"
        },
        {
          "role": "feifei",
          "text": "哈哈，是啊，像膠帶怪獸出來玩～"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：那是我剛剛撕下來的，可能掉在地上了。"
        },
        {
          "role": "lele",
          "text": "欸欸，那我們是不是誤會了？"
        },
        {
          "role": "feifei",
          "text": "有可能啦，不過我們還是多看看其他地方好了。"
        }
      ],
      "choices": [
        {
          "text": "我有一個猜想",
          "next": "scene_06_hypothesis_1",
