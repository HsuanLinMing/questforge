    "scene_10_ending_clear": {
      "title": "結尾（推理正確）",
      "narration": [
        {
          "role": "narrator",
          "text": "原來貼紙是飯糰啵啵不小心帶走的，他以為是自己的東西。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：對不起，我沒有注意到就帶走了。"
        },
        {
          "role": "lele",
          "text": "沒關係，我們都會不小心的啦！"
        },
        {
          "role": "feifei",
          "text": "下次記得看清楚位置，別讓東西跑到別人那裡。"
        },
        {
          "role": "narrator",
          "text": "爸媽老師：大家都要互相提醒，這樣才不會有誤會。"
        },
        {
          "role": "narrator",
          "text": "最後，大家一起把貼紙找回來，才藝日繼續熱鬧進行。"
        }
      ],
