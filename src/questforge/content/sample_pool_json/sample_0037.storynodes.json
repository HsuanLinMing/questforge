    "scene_02_incident": {
      "title": "發現異狀",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到那排書架前。"
        },
        {
          "role": "narrator",
          "text": "他們發現其中一排書本的位置有點歪斜，好像有人剛剛動過。"
        },
        {
          "role": "lele",
          "text": "欸？這本書怎麼不在原本的地方？"
        },
        {
          "role": "feifei",
          "text": "而且旁邊地上有一小片紙片，皺皺的，好像被揉過。"
        },
        {
          "role": "narrator",
          "text": "橡皮小方和餅乾小脆也走過來，好奇地看著這一切。"
        },
        {
          "role": "narrator",
          "text": "橡皮小方：我剛剛在這附近坐著，沒看到有人動書耶。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：我手上的果醬味道還在，但不知道跟這有沒有關係。"
        },
        {
          "role": "feifei",
          "text": "我聽到有人在另一邊輕輕地嘀咕，好像在找什麼東西。"
        },
        {
          "role": "lele",
          "text": "欸，我也聽到書架後面好像有東西掉下來的聲音。"
        },
        {
          "role": "feifei",
          "text": "我們去那邊看看，好像有點不太一樣喔。"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
