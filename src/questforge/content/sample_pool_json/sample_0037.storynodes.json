    "scene_01_warmup_3": {
      "title": "好奇心轉場（小偵探模式）",
      "narration": [
        {
          "role": "feifei",
          "text": "樂樂，你有沒有覺得，圖書館裡藏著好多秘密？"
        },
        {
          "role": "lele",
          "text": "有啊，我的眼睛現在像放大鏡一樣，亮亮的！"
        },
        {
          "role": "feifei",
          "text": "我們來開啟小聲偵探模式，偷偷觀察，不讓別人發現。"
        },
        {
          "role": "lele",
          "text": "我耳朵也變成超級雷達，什麼聲音都聽得到！"
        },
        {
          "role": "feifei",
          "text": "欸，你剛剛是不是看到那邊的書架有人動過？"
        },
        {
          "role": "lele",
          "text": "對啊，那裡好像有本書被挪了一下。"
        },
        {
          "role": "feifei",
          "text": "我們趕快過去看看，說不定會有有趣的發現！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
