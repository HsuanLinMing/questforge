    "scene_02_incident": {
      "title": "案件發生（中後段才開始）",
      "narration": [
        {
          "role": "narrator",
          "text": "才藝日的氣氛越來越熱鬧，突然，老師走到教室門口，表情有點嚴肅。"
        },
        {
          "role": "teacher",
          "text": "大家稍微安靜一下，我們發現了點小狀況。"
        },
        {
          "role": "lele",
          "text": "小狀況？是什麼？"
        },
        {
          "role": "feifei",
          "text": "我也想知道，好奇怪喔。"
        },
        {
          "role": "teacher",
          "text": "有人發現教室裡的道具位置好像被動過了，還有貼紙也不在原本的位置。"
        },
        {
          "role": "narrator",
          "text": "大家開始互相看了看，氣氛有點安靜下來。"
        },
        {
          "role": "lele",
          "text": "我剛剛看到貼紙那裡黏黏的，好像有人摸過。"
        },
        {
          "role": "feifei",
          "text": "嗯嗯，我也瞄到桌子上有點不一樣的地方。"
        },
        {
          "role": "teacher",
          "text": "我們想請幾位同學幫忙看看發生了什麼事，好嗎？"
        },
        {
          "role": "narrator",
          "text": "樂樂和霏霏對視一眼，眼睛裡閃著亮光。"
        },
        {
          "role": "feifei",
          "text": "這下有趣了，我們來當小偵探吧！"
        },
        {
          "role": "lele",
          "text": "我準備好了，偵探模式啟動！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
