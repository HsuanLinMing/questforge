    "scene_01_warmup_2": {
      "title": "開場延伸：更多日常與配角",
      "narration": [
        {
          "role": "narrator",
          "text": "操場上，橡皮小方和橡皮小圓正在比賽誰跑得快。"
        },
        {
          "role": "narrator",
          "text": "橡皮小方：我一定會贏，因為我腳步像風一樣快！"
        },
        {
          "role": "narrator",
          "text": "橡皮小圓：才不會呢，我的鞋子有秘密武器！"
        },
        {
          "role": "feifei",
          "text": "哇，秘密武器？會不會是噴射背包？"
        },
        {
          "role": "lele",
          "text": "欸欸，我也要有噴射背包，這樣我就可以飛上天了！"
        },
        {
          "role": "narrator",
          "text": "走廊的牆上貼著彩色的海報，上面寫著「才藝日快樂」的字樣，還有大家的名字。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏蹲在桌子旁邊，手裡拿著一卷閃亮的膠帶，正想幫忙貼海報。"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
