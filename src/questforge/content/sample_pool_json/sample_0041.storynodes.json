    "scene_01_start": {
      "title": "開場：運動中心的熱鬧早晨",
      "narration": [
        {
          "role": "narrator",
          "text": "今天早上，運動中心裡熱鬧非凡。"
        },
        {
          "role": "narrator",
          "text": "孩子們在籃球場邊練習投籃，跑步機上有人快步跑著。"
        },
        {
          "role": "narrator",
          "text": "霏霏和樂樂跟著爸爸媽媽來到這裡，一邊走一邊看著各種運動器材。"
        },
        {
          "role": "lele",
          "text": "哇！這裡好多球和跳繩耶！我想馬上開始玩。"
        },
        {
          "role": "feifei",
          "text": "你先別急，看看那些球怎麼擺著，可能會有趣喔。"
        },
        {
          "role": "narrator",
          "text": "籃球場旁邊，球架上掛著一頂藍色的棒球帽。"
        },
        {
          "role": "narrator",
          "text": "跑步機旁，一個小桌子上放著兩瓶水和一頂紅色的頭巾。"
        },
        {
          "role": "narrator",
          "text": "店員：歡迎大家來運動中心！記得運動前要先熱身喔！"
        },
        {
          "role": "feifei",
          "text": "欸，這個店員戴著一個橘色的圍巾，好像很暖和。"
        },
        {
          "role": "lele",
          "text": "他會不會是運動中心的秘密守護者？"
        },
        {
          "role": "feifei",
          "text": "哈哈，守護者？他看起來比較像是水壺的守護神啦。"
        },
        {
          "role": "narrator",
          "text": "旁邊的攤位有賣水果和運動飲料，還有一個叫飯糰啵啵的小朋友在挑選香蕉。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：這香蕉看起來好甜喔！我想買兩根！"
        },
        {
          "role": "lele",
          "text": "欸欸，你要不要也買個蘋果？這樣跑步才有力氣！"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：好啊！那我也去找橡皮小方看看他有沒有要買。"
        },
        {
          "role": "feifei",
          "text": "橡皮小方今天戴著一頂黃色的棒球帽，還拿著一個籃球。"
        },
        {
          "role": "lele",
          "text": "這運動中心真熱鬧，感覺每個人都有自己的小秘密裝備。"
        },
        {
          "role": "feifei",
          "text": "對啊，我覺得我們也該像小偵探一樣，用眼睛仔細看看這裡有什麼。"
        },
        {
          "role": "lele",
          "text": "小偵探？那我眼睛要亮亮的，好像放大鏡一樣！"
        },
        {
          "role": "feifei",
          "text": "沒錯，眼睛亮亮，我們來找找看有沒有什麼特別的地方。"
        },
        {
          "role": "lele",
          "text": "好耶！說不定我們會發現什麼有趣的事情！"
        },
        {
          "role": "narrator",
          "text": "店員：運動中心裡的空氣真好，大家都充滿活力呢！"
        }
      ],
      "choices": [
        {
          "text": "繼續",
          "next": "scene_01_warmup_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
