    "scene_10_ending_clear": {
      "title": "結尾（推理正確）",
      "narration": [
        {
          "role": "narrator",
          "text": "原來飯糰啵啵剛剛玩得太開心，不小心把跳繩和帽子挪動了位置。"
        },
