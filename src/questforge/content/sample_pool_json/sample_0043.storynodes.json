    "scene_02_incident": {
      "title": "便利商店的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "當霏霏和樂樂靠近收銀台時，店員小熊皺著眉頭看著收銀機旁邊的桌子。"
        },
        {
          "role": "narrator",
          "text": "店員小熊：欸，我剛剛放在這裡的糖果包裝，好像被挪動過了。"
        },
        {
          "role": "feifei",
          "text": "糖果包裝被挪動？"
        },
        {
          "role": "lele",
          "text": "我看到桌子上的糖果包裝和旁邊的飲料瓶位置不太一樣。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：我剛剛聽到有人在附近輕輕地翻找什麼東西。"
        },
        {
          "role": "feifei",
          "text": "誰在翻找呢？"
        },
        {
          "role": "narrator",
          "text": "店員小熊：我不太確定，因為那時候有其他客人也在附近。"
        },
        {
          "role": "lele",
          "text": "我看到橡皮小方剛剛離開收銀台，好像有點匆忙。"
        },
        {
          "role": "feifei",
          "text": "欸？那我們去問問他好了。"
        },
        {
          "role": "lele",
          "text": "好！我想知道他在忙什麼！"
        },
        {
          "role": "feifei",
          "text": "先不要急著猜，先看看他做了什麼動作。"
        },
        {
          "role": "lele",
          "text": "對，我會注意看的！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
