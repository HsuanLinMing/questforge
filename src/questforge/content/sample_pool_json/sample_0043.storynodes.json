    "scene_05_check_3": {
      "title": "第三個觀察點：零食區的意外發現",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂來到零食區，看到一包薯片倒在地上，旁邊還有一點點黏黏的東西。"
        },
        {
          "role": "lele",
