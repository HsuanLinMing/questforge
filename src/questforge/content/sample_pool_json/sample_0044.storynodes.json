    "scene_01_start": {
      "title": "開場：餐廳的熱鬧午餐時間",
      "narration": [
        {
          "role": "narrator",
          "text": "今天是週末，霏霏和樂樂跟爸爸媽媽一起來到一家熱鬧的餐廳吃午餐。"
        },
        {
          "role": "narrator",
          "text": "餐廳裡坐滿了客人，桌上擺著香噴噴的菜肴和閃亮的餐具。"
        },
        {
          "role": "narrator",
          "text": "霏霏和樂樂坐在一張靠窗的桌子旁，窗外可以看到街上的行人和車輛。"
        },
        {
          "role": "feifei",
          "text": "欸，樂樂，你看那個小朋友，他手上拿著一個超大的冰淇淋！"
        },
        {
          "role": "lele",
          "text": "哇！冰淇淋比他頭還大耶，我也想吃那個！"
        },
        {
          "role": "narrator",
          "text": "爸爸在點餐，他用手指指著菜單上的披薩和炸雞。"
        },
        {
          "role": "narrator",
          "text": "媽媽：記得不要吃太快，慢慢享受美食喔。"
        },
        {
          "role": "lele",
          "text": "我已經等不及了，口水都快流出來了！"
        },
        {
          "role": "narrator",
          "text": "店員小餅乾小脆穿著整齊的制服，笑咪咪地端著一盤熱騰騰的湯走過來。"
        },
        {
          "role": "narrator",
          "text": "小餅乾小脆：這是給你們的招牌南瓜濃湯，請慢用！"
        },
        {
          "role": "feifei",
          "text": "謝謝小餅乾小脆，湯聞起來好香喔！"
        },
        {
          "role": "lele",
          "text": "我想喝一大口，看看會不會變成南瓜怪獸！"
        },
        {
          "role": "feifei",
          "text": "哈哈，那你小心不要被吸進去喔！"
        },
        {
          "role": "narrator",
          "text": "隔壁桌的飯糰啵啵正在和朋友分享他最新帶來的玩具車。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：這台車跑得超快，前幾天我還讓它跳過書本呢！"
        },
        {
          "role": "lele",
          "text": "哇！我也想試試看！"
        },
        {
          "role": "narrator",
          "text": "餐廳裡傳來輕快的音樂，還有客人們的笑聲和交談聲。"
        },
        {
          "role": "feifei",
          "text": "欸，樂樂，你有沒有覺得餐桌上那個糖罐好像被動過？"
        },
        {
          "role": "lele",
          "text": "怪怪的耶，好像少了一點糖。"
        },
        {
          "role": "feifei",
          "text": "嗯，我也覺得有點不一樣，我們小聲看看有什麼發生吧！"
        },
        {
          "role": "feifei",
          "text": "我們用放大鏡模式，偷偷用眼睛看看四周，好像有什麼小秘密藏著呢！"
        },
        {
          "role": "lele",
          "text": "我的眼睛亮亮，準備當偵探！我們去瞧瞧吧！"
        }
      ],
      "choices": [
        {
          "text": "繼續",
          "next": "scene_01_warmup_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
