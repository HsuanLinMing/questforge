  "nodes": {
    "scene_01_start": {
      "title": "開場：遊樂園的歡樂時光",
      "narration": [
        {
          "role": "narrator",
          "text": "今天是個陽光明媚的早晨，霏霏和樂樂來到了熱鬧的遊樂園。"
        },
        {
          "role": "narrator",
          "text": "遊樂園裡有旋轉木馬、碰碰車和好多五顏六色的氣球。"
        },
        {
          "role": "narrator",
          "text": "他們和飯糰啵啵、膠帶小黏一起排隊準備坐摩天輪。"
        },
        {
          "role": "lele",
          "text": "哇！我最喜歡高高的地方，可以看到整個遊樂園！"
        },
        {
          "role": "feifei",
          "text": "欸，你不要一直往下看啦，會頭暈的。"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我帶了好多糖果，大家想吃嗎？"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：我帶了膠帶，可以幫忙黏東西喔！"
        },
        {
          "role": "lele",
          "text": "膠帶小黏，你能不能幫我黏住我的帽子？風好大喔！"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：沒問題！膠帶防風帽，馬上完成！"
        },
        {
          "role": "narrator",
          "text": "大家笑成一團，摩天輪慢慢轉動，風輕輕吹過臉龐。"
        },
        {
          "role": "feifei",
          "text": "欸，你看那邊的攤位，好多人在玩投籃遊戲耶。"
        },
        {
          "role": "lele",
          "text": "我要去試試看，我一定投得到！"
        },
        {
          "role": "narrator",
          "text": "飯糰啵啵：我陪你去，一起加油！"
        },
        {
          "role": "narrator",
          "text": "投籃攤位旁，餅乾小脆正在幫忙發球，臉上掛著甜甜的笑容。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：大家加油喔，投中三球有小禮物！"
        },
        {
          "role": "feifei",
          "text": "樂樂，別光顧著玩，等會還要去坐過山車呢。"
        },
        {
          "role": "lele",
          "text": "放心啦，我的手氣超好的！"
        },
        {
          "role": "narrator",
          "text": "遊樂園裡的音樂聲和歡笑聲交織成一首快樂的歌。"
        },
        {
          "role": "feifei",
          "text": "我覺得今天會有特別的事情發生呢，眼睛要亮亮的！"
        },
        {
          "role": "lele",
          "text": "對啊！像小偵探一樣，偷偷用放大鏡看一看。"
        },
        {
          "role": "feifei",
          "text": "欸，不知道會不會有什麼有趣的秘密藏在這裡？"
        },
        {
          "role": "lele",
          "text": "我準備好了！我們一起去發現吧！"
        }
      ],
      "choices": [
        {
          "text": "繼續",
          "next": "scene_01_warmup_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_2": {
      "title": "開場延伸：遊樂園裡的小插曲",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏和樂樂走到糖果攤前，看到攤位上的棉花糖像雲朵一樣蓬鬆。"
        },
        {
          "role": "lele",
          "text": "欸，棉花糖好大一朵，我想咬一口！"
        },
        {
          "role": "feifei",
          "text": "你先不要，等我拍張照，像不像一隻大白兔？"
        },
        {
          "role": "narrator",
          "text": "這時候，橡皮小方突然跑過來，手裡拿著一個搖搖晃晃的氣球。"
        },
        {
          "role": "narrator",
          "text": "橡皮小方：我的氣球快飛走了，誰幫我抓住？"
        },
        {
          "role": "lele",
          "text": "我來抓！結果氣球一飛，樂樂差點被拉著跑。"
        },
        {
          "role": "feifei",
          "text": "哈哈，你像被氣球帶著跑的狗狗。"
        },
        {
          "role": "narrator",
          "text": "大家一起笑著，氣氛輕鬆又歡樂。"
        },
        {
          "role": "lele",
          "text": "我覺得遊樂園裡每個角落都有驚喜！"
        },
        {
          "role": "feifei",
          "text": "對啊，我們繼續走，看看還有什麼好玩的。"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_01_warmup_3": {
      "title": "好奇心轉場：小偵探模式啟動",
      "narration": [
        {
          "role": "feifei",
          "text": "你看你看，那邊的旋轉木馬，好像有人偷偷把一匹馬的尾巴綁起來了耶。"
        },
        {
          "role": "lele",
          "text": "真的假的啦？會不會是馬兒在玩捉迷藏？"
        },
        {
          "role": "feifei",
          "text": "哈哈，也許牠們在開秘密派對，只有我們沒被邀請。"
        },
        {
          "role": "lele",
          "text": "我們要不要悄悄靠近，用放大鏡模式看清楚？"
        },
        {
          "role": "feifei",
          "text": "好啊，我的眼睛現在亮亮的，準備發現秘密。"
        },
        {
          "role": "lele",
          "text": "出發！小偵探隊，前進！"
        }
      ],
      "choices": [
        {
          "text": "我們去看看",
          "next": "scene_02_incident",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_02_incident": {
      "title": "遊樂園的小狀況",
      "narration": [
        {
          "role": "narrator",
          "text": "當霏霏和樂樂走近旋轉木馬時，發現一匹彩色的木馬尾巴被綁成一個大大的蝴蝶結。"
        },
        {
          "role": "lele",
          "text": "欸？這尾巴怎麼會變成蝴蝶結？"
        },
        {
          "role": "feifei",
          "text": "我剛剛沒看到啊，難道是剛才有人偷偷綁的？"
        },
        {
          "role": "narrator",
          "text": "附近的店員餅乾小脆走過來，手上還拿著一卷彩色膠帶。"
        },
        {
          "role": "narrator",
          "text": "餅乾小脆：你們發現了嗎？有人把這匹馬的尾巴裝飾了一下。"
        },
        {
          "role": "lele",
          "text": "是誰呢？他們為什麼要這樣做？"
        },
        {
          "role": "feifei",
          "text": "欸欸，我們來看看有沒有什麼特別的地方，好像有點故事要發生了！"
        }
      ],
      "choices": [
        {
          "text": "一起看看發生什麼事",
          "next": "scene_03_check_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
      "can_replay": null,
      "can_quit": null
    },
    "scene_03_check_1": {
      "title": "第一個觀察點：木馬的尾巴",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏蹲下來仔細看那個蝴蝶結。"
        },
        {
          "role": "feifei",
          "text": "欸，這蝴蝶結摸起來有點黏黏的，好像用膠帶貼的。"
        },
        {
          "role": "lele",
          "text": "我聞到一點甜甜的味道，好像是草莓口味的糖果味。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏走過來，手上還拿著同款膠帶。"
        },
        {
          "role": "narrator",
          "text": "膠帶小黏：這膠帶是我昨天買的，還剩下一點點。"
        },
        {
          "role": "lele",
          "text": "那是不是有人用你的膠帶裝飾木馬尾巴？"
        },
        {
          "role": "feifei",
          "text": "嗯，可能吧，但不知道是誰喔。"
        }
      ],
      "choices": [
        {
          "text": "再找找看",
          "next": "scene_04_check_2",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
