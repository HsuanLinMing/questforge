    "scene_10_ending_defer": {
      "title": "結尾（交給大人）",
      "narration": [
        {
          "role": "narrator",
          "text": "大人：其實這件事情有點複雜，我們也需要再問問其他店員和小朋友。"
        },
        {
          "role": "feifei",
          "text": "有時候事情沒有那麼簡單，說不定還有別的原因。"
