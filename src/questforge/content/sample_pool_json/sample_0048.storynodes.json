    "scene_01_warmup_2": {
      "title": "開場延伸：運動中心的忙碌與趣味",
      "narration": [
        {
          "role": "narrator",
          "text": "運動中心的走廊裡，還有許多孩子在練習投籃。"
        },
        {
          "role": "narrator",
          "text": "一個穿著藍色運動服的橡皮小方正努力投籃，每投一次都皺著眉頭。"
        },
        {
          "role": "narrator",
          "text": "橡皮小方：哎呀，球一直彈到籃框邊，好像籃框在跟我玩躲貓貓。"
        },
        {
          "role": "feifei",
          "text": "哈哈，籃框如果會躲貓貓，那我們得讓它乖乖站好。"
        },
        {
          "role": "lele",
          "text": "我覺得籃框是在跟你賽跑，看誰先累倒。"
        },
        {
          "role": "narrator",
          "text": "大家笑成一團，橡皮小方也跟著笑了。"
        },
        {
          "role": "narrator",
          "text": "媽媽在旁邊提醒大家要多喝水，別忘了休息。"
        },
        {
          "role": "narrator",
          "text": "媽媽：運動會可不能只拼命跑，也要記得補充水分喔！"
        }
      ],
      "choices": [
        {
          "text": "再繼續",
          "next": "scene_01_warmup_3",
          "enabled": true,
          "tag": ""
        }
      ],
