    "scene_05_check_3": {
      "title": "角落的驚喜發現",
      "narration": [
        {
          "role": "narrator",
          "text": "霏霏注意到角落有一個小箱子，箱子蓋子微微開著。"
        },
        {
          "role": "feifei",
          "text": "欸，這個箱子蓋子好像沒關好。"
        },
        {
          "role": "lele",
          "text": "我剛剛看到裡面有一隻橡皮小方玩偶，牠的帽子歪掉了！"
        },
        {
          "role": "narrator",
          "text": "店員：欸，那是我們的吉祥物玩偶喔，可能被小朋友拿出來玩了。"
        },
        {
          "role": "narrator",
          "text": "旁邊還有一個小黏膠帶，像是被拉扯過，邊邊有點皺皺的。"
        },
        {
          "role": "lele",
          "text": "哈哈，我差點以為那是怪物的口水呢！"
        },
        {
          "role": "feifei",
          "text": "怪物的口水？你又開始亂想了啦！"
        }
      ],
      "choices": [
        {
          "text": "我有一個猜想",
          "next": "scene_06_hypothesis_1",
          "enabled": true,
          "tag": ""
        }
      ],
      "solution_index": null,
